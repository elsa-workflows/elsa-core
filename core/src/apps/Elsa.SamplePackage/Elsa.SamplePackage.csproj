<Project Sdk="Microsoft.NET.Sdk">

    <Import Project="../../../../Directory.Build.props" />

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <Version>$([System.Environment]::GetEnvironmentVariable('VERSION'))</Version>
        <Version Condition="'$(Version)' == ''">1.0.1</Version>
        <IsPackable>true</IsPackable>
    </PropertyGroup>

    <ItemGroup>
        <None Include="../../../../icon.png" Pack="true" PackagePath="\" />
    </ItemGroup>
    
    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
        <PackageReference Include="CShells.FastEndpoints.Abstractions" />
        <PackageReference Include="CShells.Abstractions" />
        <PackageReference Include="CShells.AspNetCore.Abstractions"/>
    </ItemGroup>
    
</Project>
