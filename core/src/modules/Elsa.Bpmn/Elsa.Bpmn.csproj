<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<Description>
			Provides BPMN execution support by wiring the Bpmn.Model and Bpmn.Semantics libraries into Elsa.
		</Description>
		<PackageTags>elsa extension module bpmn</PackageTags>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Bpmn.Model" />
		<PackageReference Include="Bpmn.Semantics" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\Elsa.Workflows.Runtime\Elsa.Workflows.Runtime.csproj" />
		<ProjectReference Include="..\Elsa.Scheduling\Elsa.Scheduling.csproj" />
	</ItemGroup>

</Project>
