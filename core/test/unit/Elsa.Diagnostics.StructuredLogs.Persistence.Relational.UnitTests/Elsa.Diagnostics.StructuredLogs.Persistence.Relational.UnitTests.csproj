<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework />
        <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
        <!-- ubuntu-latest installs only the 10.x SDK/runtime; roll forward so testhost can execute. -->
        <RollForward>LatestMajor</RollForward>
        <Include>[Elsa.Diagnostics.StructuredLogs.Persistence.Relational]*</Include>
        <Threshold>0</Threshold>
    </PropertyGroup>

    <ItemGroup Condition="'$(TargetFramework)' == 'net8.0'">
        <!-- Test Directory.Build.props pulls Mvc.Testing; the shared net8/9 CPM group pins 9.0.17, which is net9-only. -->
        <PackageReference Update="Microsoft.AspNetCore.Mvc.Testing" VersionOverride="8.0.17" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\..\src\common\Elsa.Testing.Shared\Elsa.Testing.Shared.csproj" />
        <ProjectReference Include="..\..\..\src\modules\Elsa.Diagnostics.StructuredLogs.Persistence.Relational\Elsa.Diagnostics.StructuredLogs.Persistence.Relational.csproj" />
        <ProjectReference Include="..\..\..\src\modules\Elsa.Diagnostics.StructuredLogs.Persistence.Sqlite\Elsa.Diagnostics.StructuredLogs.Persistence.Sqlite.csproj" />
    </ItemGroup>

</Project>
