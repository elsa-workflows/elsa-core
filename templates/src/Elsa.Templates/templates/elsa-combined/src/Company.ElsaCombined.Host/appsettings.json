{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning",
      "Elsa": "Information"
    }
  },
  "AllowedHosts": "*",
  "Studio": {
    "HostingModel": "Wasm"
  },
  "ConnectionStrings": {
    "Sqlite": "Data Source=App_Data/elsa.sqlite.db;Cache=Shared",
    "SqlServer": "Server=localhost;Database=Elsa;Integrated Security=true;TrustServerCertificate=true",
    "PostgreSql": "Host=localhost;Database=elsa;Username=postgres;Password=secret",
    "Oracle": "User Id=elsa;Password=secret;Data Source=//localhost:1521/ORCLPDB1"
  },
  "Http": {
    "BaseUrl": "https://localhost:5001",
    "BasePath": "/workflows"
  },
  "Api": {
    "RoutePrefix": "elsa/api"
  },
  "Identity": {
    "Tokens": {
      "SigningKey": "CHANGE_ME_TO_A_SECURE_RANDOM_KEY",
      "AccessTokenLifetime": "1:00:00:00",
      "RefreshTokenLifetime": "7:00:00:00"
    }
  },
  "CShells": {
    "Shells": {
      "Default": {
        "Configuration": {
          "WebRouting": {
            "Path": ""
          }
        },
        "Features": {
          "ShellsApi": {},
          "DefaultAuthentication": {},
          "Identity": {
            "SigningKey": "CHANGE_ME_TO_A_SECURE_RANDOM_KEY"
          },
          "FastEndpoints": {
            "GlobalRoutePrefix": "elsa/api"
          },
          //#if (useSqlitePersistence)
          "SqliteWorkflowPersistence": {
            "ConnectionString": "Data Source=App_Data/elsa.sqlite.db;Cache=Shared"
          },
          "SqliteIdentityPersistence": {
            "ConnectionString": "Data Source=App_Data/elsa.sqlite.db;Cache=Shared"
          },
          //#endif
          //#if (useSqlServerPersistence)
          "SqlServerWorkflowPersistence": {
            "ConnectionString": "Server=localhost;Database=Elsa;Integrated Security=true;TrustServerCertificate=true"
          },
          "SqlServerIdentityPersistence": {
            "ConnectionString": "Server=localhost;Database=Elsa;Integrated Security=true;TrustServerCertificate=true"
          },
          //#endif
          //#if (usePostgreSqlPersistence)
          "PostgreSqlWorkflowPersistence": {
            "ConnectionString": "Host=localhost;Database=elsa;Username=postgres;Password=secret"
          },
          "PostgreSqlIdentityPersistence": {
            "ConnectionString": "Host=localhost;Database=elsa;Username=postgres;Password=secret"
          },
          //#endif
          //#if (useOraclePersistence)
          "OracleWorkflowPersistence": {
            "ConnectionString": "User Id=elsa;Password=secret;Data Source=//localhost:1521/ORCLPDB1"
          },
          "OracleIdentityPersistence": {
            "ConnectionString": "User Id=elsa;Password=secret;Data Source=//localhost:1521/ORCLPDB1"
          },
          //#endif
          "Http": {
            "HttpActivityOptions": {
              "BaseUrl": "https://localhost:5001"
            }
          }
        }
      }
    }
  },
  "Shell": {
    "DisableAuthorization": false
  },
  "Backend": {
    "Url": "https://localhost:5001/elsa/api"
  },
  "Localization": {
    "DefaultCulture": "en-US",
    "SupportedCultures": [
      "en-US"
    ]
  },
  "Authentication": {
    //#if (useElsaIdentityAuth)
    "Provider": "ElsaIdentity",
    //#endif
    //#if (useOpenIdConnectAuth)
    "Provider": "OpenIdConnect",
    //#endif
    //#if (useElsaLoginAuth)
    "Provider": "ElsaLogin",
    //#endif
    "OpenIdConnect": {
      "Authority": "",
      "ClientId": "",
      "ClientSecret": "",
      "AuthenticationScopes": [
        "openid",
        "profile",
        "offline_access"
      ],
      "BackendApiScopes": [],
      "SaveTokens": true
    }
  }
}
