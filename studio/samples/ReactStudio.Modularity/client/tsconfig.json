{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": ["node", "vite/client"],
    "paths": { "@elsa-workflows/react-studio-sdk": ["./src/sdk.ts"] }
  },
  "include": ["src", "tests", "*.ts"]
}
