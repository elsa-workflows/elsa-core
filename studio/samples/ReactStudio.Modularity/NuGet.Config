<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="spike" value="artifacts/feed" />
    <add key="NuGet official package source" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="spike">
      <package pattern="Elsa.ReactStudio.Spike*" />
      <package pattern="Example.ReactStudio.Spike.*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
