{
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.Hosting.Lifetime": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Elsa": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Sqlite": "Data Source=App_Data/elsa.sqlite.db;Cache=Shared;"
  },
  "Http": {
    "BaseUrl": "http://localhost:13000",
    "BasePath": "/elsa-http",
    "ApiRoutePrefix": "elsa/api"
  },
  "Api": {
    "RoutePrefix": "elsa/api"
  },
  "Identity": {
    "Tokens": {
      "SigningKey": "CHANGE_ME_TO_A_SECURE_RANDOM_KEY",
      "AccessTokenLifetime": "1:00:00:00",
      "RefreshTokenLifetime": "7:00:00:00"
    }
  },
  "Shell": {
    "DisableAuthorization": false
  },
  "Presentation": {
    "Theme": "classic"
  },
  "Backend": {
    "Url": "http://127.0.0.1:8080/elsa/api"
  },
  "DesignerOptions": {
    "UseReactFlow": false
  },
  "Localization": {
    "DefaultCulture": "en-US",
    "SupportedCultures": [
      "en-GB",
      "nl-NL"
    ]
  },
  "Authentication": {
    "Provider": "ElsaIdentity",
    "Login": {
      "Theme": "classic-refined-split"
    }
  },
  "Scripting": {
    "CSharp": {
      "AllowHostCodeExecution": false
    },
    "Python": {
      "AllowHostCodeExecution": true,
      "PythonDllPath": ""
    }
  }
}
