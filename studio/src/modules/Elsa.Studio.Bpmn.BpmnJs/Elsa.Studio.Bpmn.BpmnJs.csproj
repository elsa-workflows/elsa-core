<Project Sdk="Microsoft.NET.Sdk.Razor">

    <PropertyGroup>
        <Description>The bpmn-js BPMN designer for Elsa Studio.</Description>
        <PackageTags>elsa studio module bpmn bpmn-js designer</PackageTags>
        <!--
            Not packed yet: hosts get this designer through the Studio BPMN feature, which does not reference it until
            the designer is registered. The step that adds that reference makes it packable and adds it to the release
            inventory.
        -->
        <IsPackable>false</IsPackable>
    </PropertyGroup>

    <ItemGroup>
        <SupportedPlatform Include="browser"/>
    </ItemGroup>

    <ItemGroup>
        <!-- ClientLib is built by npm into wwwroot, not by MSBuild; keep its manifests and dependencies out of the project. -->
        <Content Remove="ClientLib\**"/>
        <None Remove="ClientLib\**"/>
    </ItemGroup>

</Project>
