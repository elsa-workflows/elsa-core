@namespace Elsa.Studio.Bpmn.Components

<div class="elsa-bpmn-canvas-host @Class" style="@Style">
    @if (_failure is not null)
    {
        <div class="elsa-bpmn-canvas-host-failure" role="alert">@_failure</div>
    }
    <div @ref="_canvas" class="elsa-bpmn-canvas-host-canvas" style="width: 100%; height: 100%;"></div>
</div>
