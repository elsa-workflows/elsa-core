<Project Sdk="Microsoft.NET.Sdk.Razor">

    <PropertyGroup>
        <Description>The X6 BPMN designer for Elsa Studio.</Description>
        <PackageTags>elsa studio module bpmn x6 designer</PackageTags>
        <!--
            Not packed yet: the designer draws but cannot edit until the later steps of #8928. Step 9 makes it packable
            and adds it to the release inventory and the packaged browser-asset checks.
        -->
        <IsPackable>false</IsPackable>
    </PropertyGroup>

    <ItemGroup>
        <SupportedPlatform Include="browser"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="../Elsa.Studio.Bpmn/Elsa.Studio.Bpmn.csproj"/>
    </ItemGroup>

    <ItemGroup>
        <!-- ClientLib is built by npm into wwwroot, not by MSBuild; keep its manifests and dependencies out of the project. -->
        <Content Remove="ClientLib\**"/>
        <None Remove="ClientLib\**"/>
    </ItemGroup>

</Project>
