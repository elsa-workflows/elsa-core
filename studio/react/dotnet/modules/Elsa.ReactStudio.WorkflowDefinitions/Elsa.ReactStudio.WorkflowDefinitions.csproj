<Project Sdk="Microsoft.NET.Sdk.Razor">
  <PropertyGroup>
    <PackageId>Elsa.ReactStudio.WorkflowDefinitions</PackageId>
    <IsPackable>true</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../Elsa.ReactStudio.Host/Elsa.ReactStudio.Host.csproj" />
    <ProjectReference Include="../Elsa.ReactStudio.Designer/Elsa.ReactStudio.Designer.csproj" />
    <ProjectReference Include="../Elsa.ReactStudio.ActivityEditors/Elsa.ReactStudio.ActivityEditors.csproj" />
    <EmbeddedResource Include="wwwroot/**/*" LogicalName="ReactStudio.Module/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>
  <Target Name="RequireModuleAssets" BeforeTargets="GenerateNuspec">
    <Error Condition="!Exists('wwwroot/entry.js') Or !Exists('wwwroot/module.css')" Text="Build the React Studio workspace first: cd studio/react and run pnpm build." />
  </Target>
</Project>
