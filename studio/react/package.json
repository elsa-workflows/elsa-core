{
  "name": "@elsa-workflows/react-studio",
  "version": "3.11.0",
  "private": true,
  "scripts": {
    "dev": "pnpm build:packages && vite --host 127.0.0.1",
    "host": "dotnet run --project dotnet/Elsa.ReactStudio.Server --no-launch-profile --urls http://127.0.0.1:5201 --ReactStudio:ConfigurationFile=../../studio.config.json",
    "build": "pnpm build:packages && tsc --noEmit && node scripts/build-assets.mjs && node scripts/dependency-licenses.mjs",
    "preview": "dotnet run --project dotnet/Elsa.ReactStudio.Server --no-launch-profile --urls http://127.0.0.1:4173 --ReactStudio:ConfigurationFile=../../studio.config.json",
    "lint": "eslint .",
    "typecheck": "pnpm build:packages && tsc --noEmit",
    "test": "pnpm build:packages && vitest run",
    "test:browser": "playwright test",
    "test:settings-server": "pnpm build:packages && node scripts/test-settings-roundtrip.mjs",
    "build:packages": "pnpm --filter \"./packages/*\" run build",
    "docs:api": "pnpm build:packages && typedoc",
    "test:packages": "pnpm build:packages && node scripts/test-packed-packages.mjs",
    "test:module": "pnpm build:packages && node scripts/test-module-template.mjs",
    "test:bpmn": "pnpm build:packages && node scripts/test-bpmn-roundtrip.mjs",
    "benchmark:expressions": "pnpm build:packages && node scripts/benchmark-expression-completions.mjs",
    "check:boundaries": "node scripts/check-module-boundaries.mjs",
    "localization:extract": "node scripts/localization-catalog.mjs --write",
    "localization:check": "node scripts/localization-catalog.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-liquid": "^6.3.3",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/language": "^6.13.1",
    "@codemirror/legacy-modes": "^6.5.5",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.14",
    "@dagrejs/dagre": "^3.1.1",
    "@elsa-workflows/react-studio-api-client": "workspace:*",
    "@elsa-workflows/react-studio-sdk": "workspace:*",
    "@tanstack/react-query": "^5.104.1",
    "@uiw/react-codemirror": "^4.25.12",
    "@xyflow/react": "^12.12.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "cn": "0.4.0",
    "date-fns": "^4.4.0",
    "lucide-react": "^1.55.0",
    "nanoid": "^6.0.2",
    "next-themes": "^0.4.6",
    "oidc-client-ts": "^3.5.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-resizable-panels": "^4.14.4",
    "react-router-dom": "^7.13.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.6",
    "zustand": "^5.0.15",
    "@elsa-workflows/react-studio-auth": "workspace:*",
    "@elsa-workflows/react-studio-ui": "workspace:*",
    "i18next": "^26.5.3",
    "react-i18next": "^17.1.0"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@tailwindcss/vite": "^4",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^5.0.4",
    "eslint": "^9",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7",
    "tailwindcss": "^4",
    "typedoc": "^0.28.20",
    "typescript": "^5",
    "typescript-eslint": "^8",
    "vite": "7.3.7",
    "vitest": "^5.0.4",
    "jsdom": "^29.1.1"
  },
  "packageManager": "pnpm@10.33.0",
  "type": "module",
  "pnpm": {
    "overrides": {
      "minimatch@<11.0.1": "11.0.3"
    },
    "patchedDependencies": {
      "typedoc@0.28.20": "patches/typedoc@0.28.20.patch"
    }
  }
}
