{
  "name": "@elsa-workflows/react-studio-ui",
  "version": "3.11.0",
  "private": true,
  "type": "module",
  "description": "Elsa React Studio Preview ui",
  "files": [
    "dist",
    "README.md",
    "src/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "import": "./dist/*.js"
    },
    "./styles.css": "./src/styles.css"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "class-variance-authority": "^0.7.1",
    "cn": "0.4.0",
    "cmdk": "^1.1.1",
    "react-resizable-panels": "^4.14.4",
    "sonner": "^2.0.8",
    "next-themes": "^0.4.6",
    "tw-animate-css": "^1.4.0",
    "tailwindcss": "^4"
  },
  "peerDependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "lucide-react": "^1.55.0"
  }
}
