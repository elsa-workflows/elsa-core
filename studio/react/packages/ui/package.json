{
  "name": "@elsa-workflows/react-studio-ui",
  "version": "3.11.0",
  "private": true,
  "type": "module",
  "description": "Elsa React Studio Preview ui",
  "files": [
    "dist",
    "README.md",
    "src/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "import": "./dist/*.js"
    },
    "./styles.css": "./src/styles.css",
    "./tokens.css": "./src/tokens.css"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "class-variance-authority": "^0.7.1",
    "cn": "0.4.0",
    "cmdk": "^1.1.1",
    "react-resizable-panels": "^4.14.4",
    "sonner": "^2.0.8",
    "next-themes": "^0.4.6",
    "tw-animate-css": "^1.4.0",
    "tailwindcss": "^4",
    "zustand": "^5.0.15",
    "@elsa-workflows/react-studio-api-client": "workspace:*",
    "@elsa-workflows/react-studio-auth": "workspace:*",
    "@elsa-workflows/react-studio-sdk": "workspace:*",
    "@uiw/react-codemirror": "^4.25.12",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-liquid": "^6.3.3",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/language": "^6.13.1",
    "@codemirror/legacy-modes": "^6.5.5",
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/state": "^6.7.6",
    "date-fns": "^4.4.0"
  },
  "peerDependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "lucide-react": "^1.55.0",
    "@tanstack/react-query": "^5.104.1"
  }
}
