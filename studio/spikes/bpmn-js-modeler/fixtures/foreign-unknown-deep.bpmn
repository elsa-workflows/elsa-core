<?xml version="1.0" encoding="UTF-8"?>
<!-- Crafted for the #8901 spike: foreign and unknown content, subprocess bodies at three depths, multiple planes, colours, label DI. -->
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xmlns:elsa="https://elsaworkflows.io/schemas/bpmn/v1"
                  xmlns:camunda="http://camunda.org/schema/1.0/bpmn"
                  xmlns:acme="https://example.com/schemas/acme"
                  xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0"
                  xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0"
                  id="Definitions_spike"
                  targetNamespace="https://elsaworkflows.io/spike"
                  exporter="Spike author"
                  exporterVersion="0.0.1"
                  acme:revision="7">
  <acme:catalog version="2"><acme:entry key="root-level foreign element" /></acme:catalog>
  <bpmn:message id="Message_Order" name="OrderPlaced" />
  <bpmn:message id="Message_Cancel" name="CancelRequested" />
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_Main" name="Order handling" processRef="Process_Main" />
    <bpmn:participant id="Participant_Partner" name="Partner" />
    <bpmn:messageFlow id="MessageFlow_1" sourceRef="Participant_Partner" targetRef="Start_Msg" messageRef="Message_Order" />
  </bpmn:collaboration>
  <bpmn:process id="Process_Main" name="Main" isExecutable="true" camunda:versionTag="3" acme:owner="team-a">
    <bpmn:documentation textFormat="text/markdown"><![CDATA[Process docs with <markup> & "quotes".]]></bpmn:documentation>
    <bpmn:extensionElements>
      <acme:meta level="1">
        <acme:tag>alpha</acme:tag>
        <acme:mixed>text before <acme:b>bold</acme:b> text after</acme:mixed>
      </acme:meta>
    </bpmn:extensionElements>
    <!-- A comment inside the process -->
    <bpmn:startEvent id="Start_Msg" name="Order placed" isInterrupting="true">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_1" messageRef="Message_Order" />
    </bpmn:startEvent>
    <bpmn:serviceTask id="Task_Bound" name="Notify warehouse" camunda:asyncBefore="true" acme:sla="PT5M" legacyFlag="yes">
      <bpmn:documentation>Plain documentation &amp; an escaped ampersand.</bpmn:documentation>
      <bpmn:extensionElements>
        <camunda:inputOutput>
          <camunda:inputParameter name="orderId">${orderId}</camunda:inputParameter>
        </camunda:inputOutput>
        <elsa:activityBinding activityType="Elsa.WriteLine">
          <elsa:input name="text">{"typeName":"String","expression":{"type":"JavaScript","value":"a &lt; b &amp;&amp; c &gt; d ? \"caf\u00e9 \\n\" : 'x'"}}</elsa:input>
        </elsa:activityBinding>
        <acme:retry attempts="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_Route" name="Route?" default="Flow_Default">
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_Cond</bpmn:outgoing>
      <bpmn:outgoing>Flow_Default</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:subProcess id="Sub_L1" name="Level 1">
      <bpmn:extensionElements>
        <acme:scope depth="1" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Cond</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
      <bpmn:startEvent id="L1_Start">
        <bpmn:outgoing>L1_Flow_1</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:subProcess id="Sub_L2" name="Level 2">
        <bpmn:incoming>L1_Flow_1</bpmn:incoming>
        <bpmn:outgoing>L1_Flow_2</bpmn:outgoing>
        <bpmn:multiInstanceLoopCharacteristics isSequential="true" acme:collection="audits" />
        <bpmn:startEvent id="L2_Start">
          <bpmn:outgoing>L2_Flow_1</bpmn:outgoing>
        </bpmn:startEvent>
        <bpmn:subProcess id="Sub_L3" name="Level 3">
          <bpmn:incoming>L2_Flow_1</bpmn:incoming>
          <bpmn:outgoing>L2_Flow_2</bpmn:outgoing>
          <bpmn:startEvent id="L3_Start">
            <bpmn:outgoing>L3_Flow_1</bpmn:outgoing>
          </bpmn:startEvent>
          <bpmn:task id="Task_Deep" name="Deep task" acme:depth="3">
            <bpmn:extensionElements>
              <elsa:activityBinding activityType="Elsa.Delay">
                <elsa:input name="timeSpan">{"typeName":"TimeSpan","expression":{"type":"Literal","value":"00:00:05"}}</elsa:input>
              </elsa:activityBinding>
              <acme:note>deep foreign content</acme:note>
            </bpmn:extensionElements>
            <bpmn:incoming>L3_Flow_1</bpmn:incoming>
            <bpmn:outgoing>L3_Flow_2</bpmn:outgoing>
          </bpmn:task>
          <bpmn:endEvent id="L3_End">
            <bpmn:incoming>L3_Flow_2</bpmn:incoming>
          </bpmn:endEvent>
          <bpmn:sequenceFlow id="L3_Flow_1" sourceRef="L3_Start" targetRef="Task_Deep" />
          <bpmn:sequenceFlow id="L3_Flow_2" sourceRef="Task_Deep" targetRef="L3_End" />
        </bpmn:subProcess>
        <bpmn:endEvent id="L2_End">
          <bpmn:incoming>L2_Flow_2</bpmn:incoming>
        </bpmn:endEvent>
        <bpmn:sequenceFlow id="L2_Flow_1" sourceRef="L2_Start" targetRef="Sub_L3" />
        <bpmn:sequenceFlow id="L2_Flow_2" sourceRef="Sub_L3" targetRef="L2_End" />
      </bpmn:subProcess>
      <bpmn:boundaryEvent id="Boundary_Timer" name="Too slow" attachedToRef="Sub_L2" cancelActivity="false">
        <bpmn:outgoing>L1_Flow_3</bpmn:outgoing>
        <bpmn:timerEventDefinition id="TED_1">
          <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT1H</bpmn:timeDuration>
        </bpmn:timerEventDefinition>
      </bpmn:boundaryEvent>
      <bpmn:endEvent id="L1_End">
        <bpmn:incoming>L1_Flow_2</bpmn:incoming>
        <bpmn:incoming>L1_Flow_3</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="L1_Flow_1" sourceRef="L1_Start" targetRef="Sub_L2" />
      <bpmn:sequenceFlow id="L1_Flow_2" sourceRef="Sub_L2" targetRef="L1_End" />
      <bpmn:sequenceFlow id="L1_Flow_3" sourceRef="Boundary_Timer" targetRef="L1_End" />
    </bpmn:subProcess>
    <bpmn:subProcess id="Sub_Collapsed" name="Collapsed (own plane)">
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
      <bpmn:startEvent id="C_Start">
        <bpmn:outgoing>C_Flow_1</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:task id="C_Task" name="Inside collapsed">
        <bpmn:extensionElements>
          <elsa:activityBinding activityType="Elsa.WriteLine">
            <elsa:input name="text">{"typeName":"String","expression":{"type":"Literal","value":"collapsed"}}</elsa:input>
          </elsa:activityBinding>
        </bpmn:extensionElements>
        <bpmn:incoming>C_Flow_1</bpmn:incoming>
        <bpmn:outgoing>C_Flow_2</bpmn:outgoing>
      </bpmn:task>
      <bpmn:endEvent id="C_End">
        <bpmn:incoming>C_Flow_2</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="C_Flow_1" sourceRef="C_Start" targetRef="C_Task" />
      <bpmn:sequenceFlow id="C_Flow_2" sourceRef="C_Task" targetRef="C_End" />
    </bpmn:subProcess>
    <bpmn:subProcess id="EventSub" name="Cancellation" triggeredByEvent="true">
      <bpmn:startEvent id="E_Start" name="Cancel requested" isInterrupting="false">
        <bpmn:outgoing>E_Flow_1</bpmn:outgoing>
        <bpmn:messageEventDefinition id="MED_2" messageRef="Message_Cancel" />
      </bpmn:startEvent>
      <bpmn:task id="E_Task" name="Log cancellation">
        <bpmn:extensionElements>
          <elsa:activityBinding activityType="Elsa.WriteLine">
            <elsa:input name="text">{
  "typeName": "String",
  "expression": {"type": "Literal", "value": "naïve — ✓ &lt;&amp;&gt; cancelled"}
}</elsa:input>
          </elsa:activityBinding>
        </bpmn:extensionElements>
        <bpmn:incoming>E_Flow_1</bpmn:incoming>
        <bpmn:outgoing>E_Flow_2</bpmn:outgoing>
      </bpmn:task>
      <bpmn:endEvent id="E_End">
        <bpmn:incoming>E_Flow_2</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="E_Flow_1" sourceRef="E_Start" targetRef="E_Task" />
      <bpmn:sequenceFlow id="E_Flow_2" sourceRef="E_Task" targetRef="E_End" />
    </bpmn:subProcess>
    <bpmn:endEvent id="End_Main" name="Done">
      <bpmn:incoming>Flow_4</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="End_Default" name="Rejected">
      <bpmn:incoming>Flow_Default</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:fancyTask id="Unknown_Bpmn_Element" name="Not a BPMN element" />
    <acme:annotation id="Foreign_Outside_Extensions">foreign element outside extensionElements</acme:annotation>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="Start_Msg" targetRef="Task_Bound" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Task_Bound" targetRef="Gateway_Route" />
    <bpmn:sequenceFlow id="Flow_Cond" name="ok" sourceRef="Gateway_Route" targetRef="Sub_L1">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" language="javascript"><![CDATA[order.total < 100 && order.valid]]></bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Default" sourceRef="Gateway_Route" targetRef="End_Default" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Sub_L1" targetRef="Sub_Collapsed" />
    <bpmn:sequenceFlow id="Flow_4" sourceRef="Sub_Collapsed" targetRef="End_Main" />
    <bpmn:textAnnotation id="Annotation_1">
      <bpmn:text>Annotated end</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_1" sourceRef="End_Main" targetRef="Annotation_1" />
  </bpmn:process>
