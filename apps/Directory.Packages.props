<Project>
    <PropertyGroup>
        <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
        <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
    </PropertyGroup>
    <PropertyGroup>
        <ElsaVersion>3.9.0</ElsaVersion>
        <ElsaStudioVersion>3.9.0</ElsaStudioVersion>
        <ElsaExtensionsVersion>3.9.0</ElsaExtensionsVersion>
        <MicrosoftVersion>10.0.9</MicrosoftVersion>
    </PropertyGroup>
    <ItemGroup>
        <PackageVersion Include="Elsa" Version="$(ElsaVersion)"/>
        <PackageVersion Include="Elsa.Api.Client" Version="$(ElsaVersion)"/>
        <PackageVersion Include="Elsa.Dashboard.Api" Version="$(ElsaVersion)"/>
        <PackageVersion Include="Elsa.Expressions.CSharp" Version="$(ElsaVersion)"/>
        <PackageVersion Include="Elsa.Persistence.EFCore" Version="$(ElsaVersion)"/>
        <PackageVersion Include="Elsa.Persistence.EFCore.MySql" Version="$(ElsaVersion)"/>
        <PackageVersion Include="Elsa.Persistence.EFCore.Oracle" Version="$(ElsaVersion)"/>
        <PackageVersion Include="Elsa.Persistence.EFCore.PostgreSql" Version="$(ElsaVersion)"/>
        <PackageVersion Include="Elsa.Persistence.EFCore.Sqlite" Version="$(ElsaVersion)"/>
        <PackageVersion Include="Elsa.Persistence.EFCore.SqlServer" Version="$(ElsaVersion)"/>
        <PackageVersion Include="Elsa.Http" Version="$(ElsaVersion)"/>
        <PackageVersion Include="Elsa.Identity" Version="$(ElsaVersion)"/>
        <PackageVersion Include="Elsa.Expressions.JavaScript" Version="$(ElsaVersion)"/>
        <PackageVersion Include="Elsa.Expressions.Liquid" Version="$(ElsaVersion)"/>
        <PackageVersion Include="Elsa.Scheduling" Version="$(ElsaVersion)"/>
        <PackageVersion Include="Elsa.Workflows.Api" Version="$(ElsaVersion)"/>
        <PackageVersion Include="Elsa.Workflows.Runtime" Version="$(ElsaVersion)"/>
        <PackageVersion Include="Elsa.Workflows.Runtime.Dashboard" Version="$(ElsaVersion)"/>
        <PackageVersion Include="Elsa.Workflows.Runtime.Distributed" Version="$(ElsaVersion)"/>
    </ItemGroup>

    <ItemGroup>
        <PackageVersion Include="Elsa.Studio" Version="$(ElsaStudioVersion)"/>
        <PackageVersion Include="Elsa.Studio.Core" Version="$(ElsaStudioVersion)"/>
        <PackageVersion Include="Elsa.Studio.Core.BlazorServer" Version="$(ElsaStudioVersion)"/>
        <PackageVersion Include="Elsa.Studio.Core.BlazorWasm" Version="$(ElsaStudioVersion)"/>
        <PackageVersion Include="Elsa.Studio.Localization" Version="$(ElsaStudioVersion)"/>
        <PackageVersion Include="Elsa.Studio.Localization.BlazorServer" Version="$(ElsaStudioVersion)"/>
        <PackageVersion Include="Elsa.Studio.Localization.BlazorWasm" Version="$(ElsaStudioVersion)"/>
        <PackageVersion Include="Elsa.Studio.Login.BlazorServer" Version="$(ElsaStudioVersion)"/>
        <PackageVersion Include="Elsa.Studio.Login.BlazorWasm" Version="$(ElsaStudioVersion)"/>
        <PackageVersion Include="Elsa.Studio.Workflows.Dashboard" Version="$(ElsaStudioVersion)"/>
    </ItemGroup>

    <ItemGroup>
        <PackageVersion Include="Elsa.Agents.Activities" Version="$(ElsaExtensionsVersion)"/>
        <PackageVersion Include="Elsa.Agents.Api" Version="$(ElsaExtensionsVersion)"/>
        <PackageVersion Include="Elsa.Agents.Core" Version="$(ElsaExtensionsVersion)"/>
        <PackageVersion Include="Elsa.Agents.Persistence.EFCore.Sqlite" Version="$(ElsaExtensionsVersion)"/>
        <PackageVersion Include="Elsa.Agents.Persistence.EFCore.SqlServer" Version="$(ElsaExtensionsVersion)"/>
        <PackageVersion Include="Elsa.Agents.Persistence.EFCore.MySql" Version="$(ElsaExtensionsVersion)"/>
        <PackageVersion Include="Elsa.Agents.Persistence.EFCore.PostgreSql" Version="$(ElsaExtensionsVersion)"/>
        <PackageVersion Include="Elsa.Studio.Agents" Version="$(ElsaExtensionsVersion)"/>
        <PackageVersion Include="Elsa.Studio.Http.Webhooks" Version="$(ElsaExtensionsVersion)"/>
        <PackageVersion Include="Elsa.Studio.WorkflowContexts" Version="$(ElsaExtensionsVersion)"/>
        <PackageVersion Include="Elsa.Logging" Version="$(ElsaExtensionsVersion)"/>
        <PackageVersion Include="Elsa.Logging.Core" Version="$(ElsaExtensionsVersion)"/>
        <PackageVersion Include="Elsa.Logging.Console" Version="$(ElsaExtensionsVersion)"/>
        <PackageVersion Include="Elsa.Logging.Serilog" Version="$(ElsaExtensionsVersion)"/>
    </ItemGroup>

    <ItemGroup>
        <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="$(MicrosoftVersion)"/>
        <PackageVersion Include="Microsoft.OpenApi" Version="2.7.5"/>
        <PackageVersion Include="Microsoft.Extensions.Configuration" Version="$(MicrosoftVersion)"/>
        <PackageVersion Include="Microsoft.Extensions.Configuration.Binder" Version="$(MicrosoftVersion)"/>
        <PackageVersion Include="Microsoft.ApplicationInsights.AspNetCore" Version="2.23.0"/>
        <PackageVersion Include="Microsoft.AspNetCore.Components.WebAssembly" Version="$(MicrosoftVersion)"/>
        <PackageVersion Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="$(MicrosoftVersion)" PrivateAssets="all"/>
        <PackageVersion Include="Microsoft.AspNetCore.Components.WebAssembly.Server" Version="$(MicrosoftVersion)"/>
        <PackageVersion Include="Swashbuckle.AspNetCore" Version="10.1.0"/>
	<PackageVersion Include="AspNetCore.HealthChecks.UI.Client" Version="9.0.0"/>
    </ItemGroup>
</Project>
