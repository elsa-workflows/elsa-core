{
  "schema": 1,
  "container_release": {
    "repository": "elsa-workflows/elsa-apps",
    "workflow": ".github/workflows/container-images.yml",
    "source_ref": "main",
    "canonical_ref": "main",
    "workflow_inputs": {
      "version": "version",
      "publish": "publish",
      "images": "images",
      "expected_commit": "expected_commit",
      "core": "core_version",
      "studio": "studio_version",
      "extensions": "extensions_version"
    },
    "package_probe_ids": {
      "core": ["Elsa"],
      "studio": ["Elsa.Studio"],
      "extensions": ["Elsa.Logging"]
    },
    "package_ids": {
      "core": [
        "Elsa", "Elsa.Alterations", "Elsa.Alterations.Core", "Elsa.Api.Client", "Elsa.Api.Common",
        "Elsa.Caching", "Elsa.Common", "Elsa.Dashboard.Abstractions", "Elsa.Dashboard.Api", "Elsa.Expressions", "Elsa.Expressions.CSharp",
        "Elsa.Expressions.JavaScript", "Elsa.Expressions.Liquid", "Elsa.Features", "Elsa.Http",
        "Elsa.Identity", "Elsa.KeyValues", "Elsa.Labels", "Elsa.Mediator", "Elsa.Persistence.EFCore",
        "Elsa.Persistence.EFCore.Common", "Elsa.Persistence.EFCore.MySql", "Elsa.Persistence.EFCore.Oracle",
        "Elsa.Persistence.EFCore.PostgreSql", "Elsa.Persistence.EFCore.SqlServer", "Elsa.Persistence.EFCore.Sqlite",
        "Elsa.Resilience", "Elsa.Resilience.Core", "Elsa.SasTokens", "Elsa.Scheduling", "Elsa.Tenants",
        "Elsa.Workflows.Api", "Elsa.Workflows.Core", "Elsa.Workflows.Management", "Elsa.Workflows.Runtime",
        "Elsa.Workflows.Runtime.Dashboard", "Elsa.Workflows.Runtime.Distributed"
      ],
      "studio": [
        "Elsa.Studio", "Elsa.Studio.AI", "Elsa.Studio.ActivityPortProviders",
        "Elsa.Studio.Authentication.Abstractions", "Elsa.Studio.Authentication.Themes",
        "Elsa.Studio.Authentication.UI", "Elsa.Studio.Core", "Elsa.Studio.Core.BlazorServer",
        "Elsa.Studio.Core.BlazorWasm", "Elsa.Studio.Dashboard", "Elsa.Studio.Diagnostics.ConsoleLogs",
        "Elsa.Studio.Diagnostics.ConsoleLogs.Dashboard", "Elsa.Studio.Diagnostics.OpenTelemetry",
        "Elsa.Studio.Diagnostics.OpenTelemetry.Dashboard", "Elsa.Studio.Diagnostics.StructuredLogs",
        "Elsa.Studio.Diagnostics.StructuredLogs.Dashboard", "Elsa.Studio.DomInterop",
        "Elsa.Studio.Localization", "Elsa.Studio.Localization.BlazorServer",
        "Elsa.Studio.Localization.BlazorWasm", "Elsa.Studio.Login", "Elsa.Studio.Login.BlazorServer",
        "Elsa.Studio.Login.BlazorWasm", "Elsa.Studio.Secrets", "Elsa.Studio.Security",
        "Elsa.Studio.Settings", "Elsa.Studio.Shared", "Elsa.Studio.Shell", "Elsa.Studio.UIHints",
        "Elsa.Studio.UserTasks", "Elsa.Studio.Workflows", "Elsa.Studio.Workflows.Core",
        "Elsa.Studio.Workflows.Dashboard", "Elsa.Studio.Workflows.Designer"
      ],
      "extensions": [
        "Elsa.Agents.Activities", "Elsa.Agents.Api", "Elsa.Agents.Core", "Elsa.Agents.Models",
        "Elsa.Agents.Persistence", "Elsa.Agents.Persistence.EFCore", "Elsa.Agents.Persistence.EFCore.MySql",
        "Elsa.Agents.Persistence.EFCore.PostgreSql", "Elsa.Agents.Persistence.EFCore.SqlServer",
        "Elsa.Agents.Persistence.EFCore.Sqlite", "Elsa.Logging", "Elsa.Logging.Console", "Elsa.Logging.Core",
        "Elsa.Logging.Serilog", "Elsa.Studio.Agents", "Elsa.Studio.Http.Webhooks", "Elsa.Studio.WorkflowContexts"
      ]
    },
    "images": [
      {
        "name": "server",
        "repository": "elsaworkflows/elsa-server-app",
        "tag": "{version}",
        "release_repositories": ["core", "extensions"],
        "packages": ["core", "extensions"],
        "platforms": ["linux/amd64", "linux/arm64"]
      },
      {
        "name": "studio-server",
        "repository": "elsaworkflows/elsa-studio-blazor-server-app",
        "tag": "{version}",
        "release_repositories": ["studio", "extensions"],
        "packages": ["core", "studio", "extensions"],
        "platforms": ["linux/amd64", "linux/arm64"]
      },
      {
        "name": "studio-wasm",
        "repository": "elsaworkflows/elsa-studio-blazor-wasm-app",
        "tag": "{version}",
        "release_repositories": ["studio", "extensions"],
        "packages": ["core", "studio", "extensions"],
        "platforms": ["linux/amd64", "linux/arm64"]
      },
      {
        "name": "studio-wasm-standalone",
        "repository": "elsaworkflows/elsa-studio-blazor-wasm-standalone-app",
        "tag": "{version}",
        "release_repositories": ["studio", "extensions"],
        "packages": ["core", "studio", "extensions"],
        "platforms": ["linux/amd64", "linux/arm64"]
      },
      {
        "name": "server-studio-server",
        "repository": "elsaworkflows/elsa-server-studio-blazor-server-app",
        "tag": "{version}",
        "release_repositories": ["studio", "extensions"],
        "packages": ["core", "studio", "extensions"],
        "platforms": ["linux/amd64", "linux/arm64"]
      },
      {
        "name": "server-studio-wasm",
        "repository": "elsaworkflows/elsa-server-studio-blazor-wasm-app",
        "tag": "{version}",
        "release_repositories": ["studio", "extensions"],
        "packages": ["core", "studio", "extensions"],
        "platforms": ["linux/amd64", "linux/arm64"]
      },
      {
        "name": "studio-wasm-alias",
        "repository": "elsaworkflows/elsa-studio",
        "tag": "{version}",
        "release_repositories": ["studio", "extensions"],
        "packages": ["core", "studio", "extensions"],
        "platforms": ["linux/amd64", "linux/arm64"],
        "alias_of": "studio-wasm"
      },
      {
        "name": "server-alias",
        "repository": "elsaworkflows/elsa-server",
        "tag": "{version}",
        "release_repositories": ["core", "extensions"],
        "packages": ["core", "extensions"],
        "platforms": ["linux/amd64", "linux/arm64"],
        "alias_of": "server"
      }
    ]
  },
  "repositories": [
    {
      "name": "core",
      "directory": "elsa-core",
      "github": "elsa-workflows/elsa-core",
      "solution": "Elsa.sln",
      "workflow": "packages.yml",
      "dependencies": [],
      "alignment": [],
      "required_jobs": [
        "Build packages",
        "Publish to feedz.io",
        "Publish release to nuget.org"
      ],
      "fixed_packages": {
        "Elsa.SamplePackage": {
          "version": "1.0.1",
          "verify_published": false,
          "reason": "Sample project has its own fixed version; validate its artifact but do not require republishing an immutable sample version."
        }
      },
      "npm": []
    },
    {
      "name": "studio",
      "directory": "elsa-studio",
      "github": "elsa-workflows/elsa-studio",
      "solution": "Elsa.Studio.sln",
      "workflow": "packages.yml",
      "dependencies": [
        "core"
      ],
      "alignment": [
        {
          "file": "Directory.Packages.props",
          "package": "Elsa.Api.Client"
        }
      ],
      "required_jobs": [
        "Build packages",
        "Publish npm packages to feedz.io",
        "Publish npm packages to npmjs.com",
        "Publish nuget packages to feedz.io",
        "Publish to nuget.org"
      ],
      "fixed_packages": {},
      "npm": [
        "@elsa-workflows/elsa-studio-wasm",
        "@elsa-workflows/elsa-studio-wasm-react"
      ]
    },
    {
      "name": "extensions",
      "directory": "elsa-extensions",
      "github": "elsa-workflows/elsa-extensions",
      "solution": "Elsa.Extensions.sln",
      "workflow": "packages.yml",
      "dependencies": [
        "core",
        "studio"
      ],
      "alignment": [
        {
          "file": "Directory.Build.props",
          "property": "ElsaVersion"
        },
        {
          "file": "Directory.Build.props",
          "property": "ElsaStudioVersion"
        }
      ],
      "required_jobs": [
        "Build packages",
        "Publish to feedz.io",
        "Publish release to nuget.org"
      ],
      "fixed_packages": {},
      "npm": []
    },
    {
      "name": "templates",
      "directory": "elsa-templates",
      "github": "elsa-workflows/elsa-templates",
      "solution": "Elsa.Templates.slnx",
      "workflow": "packages.yml",
      "artifact": "elsa-template-packages",
      "dependencies": [
        "core",
        "studio"
      ],
      "stage_after": [
        "extensions"
      ],
      "source_policy": {
        "stable": "origin/main",
        "prerelease": "origin/release/{base}"
      },
      "alignment": [
        {
          "file": "src/Elsa.Templates/Elsa.Templates.csproj",
          "property": "Version"
        },
        {
          "file": ".github/workflows/packages.yml",
          "yaml_key": "BASE_VERSION",
          "base_version": true
        },
        {
          "glob": "src/Elsa.Templates/templates/**/*.csproj",
          "package_prefix": "Elsa"
        },
        {
          "file": "elsa-templates.csproj",
          "package_prefix": "Elsa"
        },
        {
          "glob": "src/Elsa.Templates/templates/**/StudioBrandingProvider.cs",
          "studio_branding": true
        },
        {
          "file": "test/Elsa.Templates.Tests/TemplateSmokeTests.cs",
          "string_constant": "ElsaVersion"
        }
      ],
      "content_expectations": {
        "source_root": "src/Elsa.Templates",
        "source_globs": [
          "templates/**/*.csproj"
        ],
        "template_config_globs": [
          "templates/**/.template.config/template.json"
        ],
        "archive_prefix": "content/",
        "archive_source_prefix": "templates/",
        "package_prefixes": [
          "Elsa"
        ],
        "upstream_repositories": [
          "core",
          "studio"
        ]
      },
      "expected_package_ids": [
        "Elsa.Templates"
      ],
      "recovery_artifact": "elsa-template-recovery-evidence",
      "required_jobs": [
        "Build packages",
        "Publish to feedz.io",
        "Publish to nuget.org"
      ],
      "fixed_packages": {},
      "npm": []
    }
  ],
  "feeds": [
    {
      "name": "nuget",
      "base_url": "https://api.nuget.org/v3-flatcontainer"
    },
    {
      "name": "feedz",
      "base_url": "https://f.feedz.io/elsa-workflows/elsa-3/nuget/v3/packages"
    }
  ],
  "release_kinds": {
    "stable": {
      "feeds": [
        "nuget",
        "feedz"
      ],
      "npm_dist_tag": "latest"
    },
    "rc": {
      "feeds": [
        "nuget",
        "feedz"
      ],
      "npm_dist_tag": "next"
    },
    "preview": {
      "feeds": [
        "nuget",
        "feedz"
      ],
      "npm_dist_tag": "next"
    }
  },
  "post_release_sites": {
    "website": {
      "platform": "Lovable",
      "project_id": "42142296-d1c7-49c5-aeb5-ced6054f340b",
      "project_name": "Elsa Hub",
      "workspace_name": "Skywalker Digital",
      "workspace_id": null,
      "production_urls": [
        "https://www.elsaworkflows.io"
      ],
