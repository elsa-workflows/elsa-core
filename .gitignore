# Ignore thumbnails created by Windows
Thumbs.db

# Ignore files built by Visual Studio
*.obj
*.exe
*.pdb
*.user
*.aps
*.pch
*.vspscc
*_i.c
*_p.c
*.ncb
*.suo
*.tlb
*.tlh
*.bak
*.cache
*.ilk
*.log
[Bb]in
[Dd]ebug*/
*.lib
*.sbr
obj/
# Build output only. Left unanchored this also matched documentation and tooling
# directories such as docs/images/releases/ and .claude/skills/release-*/, which
# were then silently excluded from commits. bin/ and obj/ are already ignored above.
/[Rr]elease*/
_ReSharper*/
[Tt]est[Rr]esult*
.vs/

# VS Code/Omnisharp crash dumps
mono_crash.mem*.blob

# Nuget packages folder
packages/

# Ignore git-related files
*.orig

# Rider
.idea
.run

# wwwroot
wwwroot/
# Studio keeps hand-authored static files under wwwroot. These three output
# directories are generated by npm or copied from authored Assets/ at build.
!studio/src/**/wwwroot/
studio/src/framework/Elsa.Studio.DomInterop/wwwroot/
studio/src/modules/Elsa.Studio.Workflows.Designer/wwwroot/
studio/src/modules/Elsa.Studio.Alterations/wwwroot/

# Per-developer Studio host overrides can contain local credentials.
studio/src/**/appsettings.Local.json

# Generated Studio tooling output relocated from its standalone repository.
studio/src/hosts/Elsa.Studio.Host.CustomElements/wasm/
studio/samples/react/workflow-definition-editor-sample/workflow-definition-editor-app/public/_content/
studio/samples/react/workflow-definition-editor-sample/workflow-definition-editor-app/public/_framework/
studio/samples/react/workflow-definition-editor-sample/workflow-definition-editor-app/public/appsettings.json
studio/src/modules/Elsa.Studio.Workflows.Designer/ClientLib/package-lock.json
studio/src/framework/Elsa.Studio.DomInterop/ClientLib/package-lock.json
studio/test/browser/**/test-results/
studio/src/wrappers/.npmrc

# Developer-local Extensions outputs and publishing credentials after relocation.
# Keep these scoped to the imported tree; Core/Studio authors may check in
# similarly named fixtures intentionally.
extensions/src/**/*.rsuser
extensions/src/**/*.userprefs
extensions/src/**/*.DotSettings.user
extensions/src/**/*.pubxml
extensions/src/**/*.azurePubxml
extensions/src/**/*.publishsettings
extensions/src/**/*.pfx
extensions/src/**/*.binlog
extensions/src/**/PublishScripts/
extensions/src/**/__pycache__/
extensions/src/**/*.pyc

# npm
node_modules/
.babelrc
.stylelintrc.yml
.eslintrc.yml

# volatile
App_Data/
*.db
*.db-journal
*.db-shm
*.db-wal
.DS_Store

# Fody - auto-generated XML schema
FodyWeavers.xsd

# Elsa Stencil Components
core/src/designer/elsa-workflows-designer/dist
core/src/designer/elsa-workflows-designer/www
core/src/designer/elsa-workflows-designer/loader

# Created by developers using GNU/Linux
.directory

core/src/modules/Elsa.Workflows.Designer/package-lock.json

unlist.sh

# build artifacts
/artifacts

/docker/data/
/docker/azurite-data/
docker/docker-compose-datadog.yml

# Test results
TestResults/
artifacts/
BenchmarkDotNet.Artifacts/
