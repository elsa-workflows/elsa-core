# Root Docker builds copy source from this repository context. Keep local
# credentials and generated outputs out of the context sent to the builder.
**/.git
**/.env
**/.env.*
**/appsettings.Local.json
**/secrets.dev.yaml
**/values.dev.yaml
**/*.pfx
**/*.publishsettings
**/*.db
**/*.db-wal
**/*.db-shm
**/.vs
**/.idea
**/.vscode
**/bin
**/obj
**/node_modules
**/TestResults
**/test-results
**/artifacts
**/*.nupkg
**/*.snupkg
# React Studio builds these outputs inside its asset stage.
studio/react/dist
studio/react/packages/*/dist
studio/react/docs/api
studio/react/module-assets
studio/react/dotnet/modules/*/wwwroot
