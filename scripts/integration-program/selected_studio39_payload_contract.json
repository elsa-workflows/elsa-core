      "package": {
        "name": "@elsa-workflows/elsa-studio-wasm-react",
        "version": "0.0.0",
        "repository": {
          "type": "git",
          "url": "git+https://github.com/elsa-workflows/elsa-studio.git"
        },
        "type": "module",
        "description": "React wrapper for Elsa Studio, exposing the Blazor WebAssembly workflow designer as React components.",
