            "import": "./dist/elsa-studio-wasm-react.js",
            "require": "./dist/elsa-studio-wasm-react.umd.cjs"
          }
        },
        "scripts": {
          "dev": "vite",
          "build": "vite build",
          "lint": "eslint . --ext js,jsx --report-unused-disable-directives --max-warnings 0",
          "preview": "vite preview",
          "storybook": "storybook dev -p 6006",
          "build-storybook": "storybook build",
          "postinstall": "npm run copy:elsa-studio-wasm",
          "copy:elsa-studio-wasm": "node -e \"const fs=require('node:fs'),path=require('node:path'),source=path.dirname(require.resolve('@elsa-workflows/elsa-studio-wasm/package.json'));fs.mkdirSync('public',{recursive:true});for(const name of ['_content','_framework','appsettings.json'])fs.cpSync(path.join(source,name),path.join('public',name),{recursive:true});\""
        },
        "dependencies": {
