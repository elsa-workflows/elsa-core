diff --git a/test/studio/Shared/StudioSourceFiles.cs b/test/studio/Shared/StudioSourceFiles.cs
new file mode 100644
--- /dev/null
+++ b/test/studio/Shared/StudioSourceFiles.cs
@@ -0,0 +1,26 @@
+namespace Elsa.Studio.Testing;
+
+/// <summary>Resolves the same Studio source contracts in standalone and consolidated checkouts.</summary>
+internal static class StudioSourceFiles
+{
+    public static string Read(params string[] pathSegments)
+    {
+        if (pathSegments.Length < 2 || pathSegments[0] != "src")
+        {
+            throw new ArgumentException("Expected a Studio source path beginning with src.", nameof(pathSegments));
+        }
+
+        for (var current = new DirectoryInfo(AppContext.BaseDirectory); current is not null; current = current.Parent)
+        {
+            foreach (var sourceRoot in new[] { Path.Combine(current.FullName, "src", "studio"), Path.Combine(current.FullName, "src") })
+            {
+                if (File.Exists(Path.Combine(sourceRoot, "framework", "Elsa.Studio.Core", "Elsa.Studio.Core.csproj")))
+                {
+                    return File.ReadAllText(Path.Combine([sourceRoot, .. pathSegments[1..]]));
+                }
+            }
+        }
+
+        throw new DirectoryNotFoundException("Could not locate the standalone or consolidated Elsa Studio source tree.");
+    }
+}
