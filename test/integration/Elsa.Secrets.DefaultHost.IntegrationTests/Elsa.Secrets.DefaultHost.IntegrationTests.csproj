<!-- TreatAsLocalProperty lets the CollectCoverage setting below win over CI's /p:CollectCoverage=true. -->
<Project Sdk="Microsoft.NET.Sdk" TreatAsLocalProperty="CollectCoverage">

    <PropertyGroup>
        <!-- Coverage is off for the same reason as Elsa.Hosts.SmokeTests: this project boots the whole Workbench graph,
             which coverlet cannot instrument, and startup touches only a thin slice of it. -->
        <CollectCoverage>false</CollectCoverage>
        <!-- Inherited from the Workbench: Pomelo.EntityFrameworkCore.MySql 9.0.0 doesn't support EF Core 10. -->
        <NoWarn>$(NoWarn);NU1608</NoWarn>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\..\samples\extensions\workbench\Elsa.Server.Web\Elsa.Server.Web.csproj" />
    </ItemGroup>

    <ItemGroup>
        <None Include="..\..\..\scripts\integration-program\secrets-api-studio-contract.json" Link="secrets-api-studio-contract.json" CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>

</Project>
