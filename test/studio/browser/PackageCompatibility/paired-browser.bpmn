<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  id="Definitions_paired_browser" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:process id="paired-process" name="Paired browser BPMN" isExecutable="true">
    <bpmn:startEvent id="paired-start" name="Paired start">
      <bpmn:outgoing>paired-flow</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:endEvent id="paired-end" name="Paired end">
      <bpmn:incoming>paired-flow</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="paired-flow" sourceRef="paired-start" targetRef="paired-end" />
  </bpmn:process>
</bpmn:definitions>
