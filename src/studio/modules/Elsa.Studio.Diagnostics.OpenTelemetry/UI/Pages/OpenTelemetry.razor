@page "/diagnostics/opentelemetry"
@attribute [RequirePermission(OpenTelemetryPermissions.OpenTelemetry, PermissionVerbs.View)]
@using System.Text.Json
@using Elsa.Studio.Contracts
@using Elsa.Studio.Diagnostics.OpenTelemetry.Contracts
@using Microsoft.AspNetCore.WebUtilities
@using Microsoft.JSInterop
@inherits StudioComponentBase
@implements IAsyncDisposable
@inject IOpenTelemetryService TelemetryService
@inject IOpenTelemetryObserver TelemetryObserver
@inject IRemoteFeatureProvider RemoteFeatureProvider
@inject NavigationManager NavigationManager
@inject IJSRuntime JSRuntime
@inject ILocalizer Localizer

<PageTitle>@Localizer["OpenTelemetry"]</PageTitle>

<MudContainer MaxWidth="MaxWidth.False" Class="elsa-otel-page-shell">
    <MudStack Row="true" Wrap="Wrap.Wrap" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Spacing="2">
        <PageHeading Text="@Localizer["OpenTelemetry"]" />
        <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.FlexEnd" Spacing="1" Class="flex-wrap">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@(_liveEnabled ? Icons.Material.Filled.Pause : Icons.Material.Filled.PlayArrow)" OnClick="ToggleLiveAsync">
                @(_liveEnabled ? Localizer["Stop live updates"] : Localizer["Start live updates"])
            </MudButton>
            <MudTooltip Text="@Localizer["Refresh"]" Delay="500">
                <MudIconButton Icon="@Icons.Material.Outlined.Refresh" Color="Color.Primary" Disabled="@_loading" OnClick="LoadAsync" />
            </MudTooltip>
            <MudTooltip Text="@Localizer["Clear view"]" Delay="500">
                <MudIconButton Icon="@Icons.Material.Outlined.DeleteSweep" Disabled="@IsTelemetryEmpty" OnClick="ClearViewAsync" />
            </MudTooltip>
            <MudTooltip Text="@Localizer["Export visible telemetry"]" Delay="500">
                <MudIconButton Icon="@Icons.Material.Outlined.Download" Disabled="@IsTelemetryEmpty" OnClick="ExportTelemetryAsync" />
            </MudTooltip>
        </MudStack>
    </MudStack>
    <MudStack Spacing="1" Class="mb-4 elsa-otel-fixed-section">
        <MudText Typo="Typo.body2" Color="Color.Secondary">@StatusText</MudText>
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1" Class="flex-wrap">
            <MudChip T="string" Size="Size.Small" Variant="Variant.Filled" Color="@LiveChipColor">@LiveChipText</MudChip>
            <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="@CollectorChipColor">@CollectorStatusText</MudChip>
            <MudText Typo="Typo.caption" Color="Color.Secondary">@LastUpdateText</MudText>
        </MudStack>
    </MudStack>

    @if (_loading)
    {
        <MudProgressLinear Indeterminate="true" Color="Color.Primary" aria-label="Loading OpenTelemetry diagnostics" />
    }
    else if (!string.IsNullOrWhiteSpace(_error))
    {
        <MudAlert Severity="Severity.Error" Dense="true">@_error</MudAlert>
    }
    else
    {
        <MudPaper Elevation="0" Outlined="true" Class="mb-4 elsa-otel-fixed-section elsa-otel-summary-surface">
            <div class="elsa-otel-summary-strip" role="list" aria-label="OpenTelemetry summary">
                <div class="elsa-otel-summary-item" role="listitem">
                    <div>
                        <MudText Typo="Typo.overline">@Localizer["Resources"]</MudText>
                        <div class="elsa-otel-summary-value">
                            <MudText Typo="Typo.h5">@_resources.Count</MudText>
                            <MudText Typo="Typo.caption" Color="Color.Secondary">@ActiveResourceText</MudText>
                        </div>
                    </div>
                    <MudIcon Icon="@Icons.Material.Outlined.CloudQueue" Size="Size.Small" Color="Color.Primary" />
                </div>
                <div class="elsa-otel-summary-item" role="listitem">
                    <div>
                        <MudText Typo="Typo.overline">@Localizer["Traces"]</MudText>
                        <div class="elsa-otel-summary-value">
                            <MudText Typo="Typo.h5">@FilteredTraces.Count</MudText>
                            <MudText Typo="Typo.caption" Color="Color.Secondary">@TraceSupportText</MudText>
                        </div>
                    </div>
                    <MudIcon Icon="@Icons.Material.Outlined.Timeline" Size="Size.Small" Color="Color.Primary" />
                </div>
                <div class="elsa-otel-summary-item" role="listitem">
                    <div>
                        <MudText Typo="Typo.overline">@Localizer["Metrics"]</MudText>
                        <div class="elsa-otel-summary-value">
                            <MudText Typo="Typo.h5">@_metrics.Instruments.Count</MudText>
                            <MudText Typo="Typo.caption" Color="Color.Secondary">@Localizer["OTLP received"]</MudText>
                        </div>
                    </div>
                    <MudIcon Icon="@Icons.Material.Outlined.QueryStats" Size="Size.Small" Color="Color.Primary" />
                </div>
                <div class="elsa-otel-summary-item" role="listitem">
                    <div>
                        <MudText Typo="Typo.overline">@Localizer["Logs"]</MudText>
                        <div class="elsa-otel-summary-value">
                            <MudText Typo="Typo.h5">@_logs.Count</MudText>
                            <MudText Typo="Typo.caption" Color="Color.Secondary">@Localizer["Structured + OTLP"]</MudText>
                        </div>
                    </div>
                    <MudIcon Icon="@Icons.Material.Outlined.Article" Size="Size.Small" Color="Color.Primary" />
                </div>
                <div class="elsa-otel-summary-item" role="listitem">
                    <div>
                        <MudText Typo="Typo.overline">@Localizer["Dropped"]</MudText>
                        <div class="elsa-otel-summary-value">
                            <MudText Typo="Typo.h5" Color="@DroppedTextColor">@DroppedCount</MudText>
                            <MudText Typo="Typo.caption" Color="Color.Secondary">@DroppedSupportText</MudText>
                        </div>
                    </div>
                    <MudIcon Icon="@DroppedIcon" Size="Size.Small" Color="@DroppedTextColor" />
                </div>
            </div>
        </MudPaper>

        <MudPaper Elevation="0" Outlined="true" Class="pa-4 mb-4 elsa-otel-fixed-section">
            <MudStack Spacing="3">
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1" Class="flex-wrap">
                    <MudText Typo="Typo.overline">@Localizer["Resource"]</MudText>
                    <ResourcePicker Resources="_resources" SelectedResourceId="_selectedResourceId" SelectedResourceIdChanged="OnResourceSelectedAsync" />
                </MudStack>
                <MudGrid Spacing="3">
                    <MudItem xs="12" md="6">
                        <MudTextField T="string" Value="@_urlState.Text" ValueChanged="SetSearchAsync" Label="@Localizer["Search"]" Placeholder="@Localizer["Trace, operation, or ID"]" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Outlined.Search" Variant="Variant.Outlined" Margin="Margin.Dense" Immediate="true" DebounceInterval="300" />
                    </MudItem>
                    <MudItem xs="12" sm="6" md="2">
                        <MudSelect T="SpanStatus?" Value="@_urlState.Status" ValueChanged="SetStatusAsync" Label="@Localizer["Status"]" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true">
                            <MudSelectItem T="SpanStatus?" Value="@(null)">@Localizer["All"]</MudSelectItem>
                            @foreach (var status in Enum.GetValues<SpanStatus>())
                            {
                                <MudSelectItem T="SpanStatus?" Value="@status">@status</MudSelectItem>
                            }
                        </MudSelect>
                    </MudItem>
                    <MudItem xs="12" sm="6" md="2">
                        <MudSelect T="string" Value="@_durationFilter" ValueChanged="SetDurationFilterAsync" Label="@Localizer["Duration"]" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true">
                            <MudSelectItem T="string" Value="@(\"any\")">@Localizer["Any"]</MudSelectItem>
                            <MudSelectItem T="string" Value="@(\"fast\")">@Localizer["Under 50ms"]</MudSelectItem>
                            <MudSelectItem T="string" Value="@(\"medium\")">@Localizer["50-500ms"]</MudSelectItem>
                            <MudSelectItem T="string" Value="@(\"slow\")">@Localizer["Over 500ms"]</MudSelectItem>
                        </MudSelect>
                    </MudItem>
                    <MudItem xs="12" md="2" Class="d-flex align-center justify-end">
                        <MudButton Variant="Variant.Text" Color="Color.Primary" StartIcon="@Icons.Material.Outlined.RestartAlt" OnClick="ResetFiltersAsync">@Localizer["Reset"]</MudButton>
                    </MudItem>
                </MudGrid>
            </MudStack>
        </MudPaper>

        <MudPaper Elevation="0" Outlined="true" Class="pa-4 elsa-otel-tabs-paper">
                <MudTabs Class="elsa-otel-tabs" Elevation="0" Rounded="false" Border="false" ActivePanelIndex="@ActiveTabIndex" ActivePanelIndexChanged="SelectTabIndexAsync">
                    <MudTabPanel Text="@Localizer["Overview"]">
                        <MudGrid Spacing="2">
                            <MudItem xs="12" md="3">
                                <MudPaper Elevation="0" Outlined="true" Class="pa-4 elsa-otel-overview-card">
                                    <MudText Typo="Typo.overline">@Localizer["Trace latency"]</MudText>
                                    <MudText Typo="Typo.h5">@AverageTraceDurationText</MudText>
                                    <MudText Typo="Typo.caption">@Localizer["Average visible trace duration"]</MudText>
                                </MudPaper>
                            </MudItem>
                            <MudItem xs="12" md="3">
                                <MudPaper Elevation="0" Outlined="true" Class="pa-4 elsa-otel-overview-card">
                                    <MudText Typo="Typo.overline">@Localizer["Errors"]</MudText>
                                    <MudText Typo="Typo.h5" Color="@ErrorRateColor">@TraceErrorRateText</MudText>
                                    <MudText Typo="Typo.caption">@DroppedSupportText</MudText>
                                </MudPaper>
                            </MudItem>
                            <MudItem xs="12" md="3">
                                <MudPaper Elevation="0" Outlined="true" Class="pa-4 elsa-otel-overview-card">
                                    <MudText Typo="Typo.overline">@Localizer["Log volume"]</MudText>
                                    <MudText Typo="Typo.h5">@_logs.Count</MudText>
                                    <MudText Typo="Typo.caption">@Localizer["Visible OTLP log records"]</MudText>
                                </MudPaper>
                            </MudItem>
                            <MudItem xs="12" md="3">
                                <MudPaper Elevation="0" Outlined="true" Class="pa-4 elsa-otel-overview-card">
                                    <MudText Typo="Typo.overline">@Localizer["Collector"]</MudText>
                                    <MudText Typo="Typo.h5">@CollectorShortStatus</MudText>
                                    <MudText Typo="Typo.caption">@CollectorProtocolText</MudText>
                                </MudPaper>
                            </MudItem>
                            <MudItem xs="12" md="7">
                                <MudPaper Elevation="0" Outlined="true" Class="pa-4">
                                    <MudText Typo="Typo.subtitle2" Class="mb-2">@Localizer["Top operations"]</MudText>
                                    @if (TopOperations.Count == 0)
                                    {
                                        <MudAlert Severity="Severity.Normal" Variant="Variant.Text">@Localizer["No traces received."]</MudAlert>
                                    }
                                    else
                                    {
                                        <MudSimpleTable Dense="true" Hover="true">
                                            <tbody>
                                            @foreach (var operation in TopOperations)
                                            {
                                                <tr>
                                                    <td><strong>@operation.Name</strong></td>
                                                    <td>@operation.Count @Localizer["traces"]</td>
                                                    <td>@FormatDuration(operation.AverageDuration)</td>
                                                </tr>
                                            }
                                            </tbody>
                                        </MudSimpleTable>
                                    }
                                </MudPaper>
                            </MudItem>
                            <MudItem xs="12" md="5">
                                <MudPaper Elevation="0" Outlined="true" Class="pa-4">
                                    <MudText Typo="Typo.subtitle2" Class="mb-2">@Localizer["Collector setup"]</MudText>
                                    <MudSimpleTable Dense="true" Hover="false">
                                        <tbody>
                                        <tr><th>@Localizer["HTTP"]</th><td>@EndpointStatus(_collectorConfiguration?.Http)</td></tr>
                                        <tr><th>@Localizer["gRPC"]</th><td>@EndpointStatus(_collectorConfiguration?.Grpc)</td></tr>
                                        <tr><th>@Localizer["Headers"]</th><td>@RequiredHeaderText</td></tr>
                                        </tbody>
                                    </MudSimpleTable>
                                </MudPaper>
                            </MudItem>
                        </MudGrid>
                    </MudTabPanel>
                    <MudTabPanel Text="@Localizer["Resources"]">
                        @if (_resources.Count == 0)
                        {
                            <MudAlert Severity="Severity.Normal" Variant="Variant.Text">@Localizer["No OpenTelemetry resources received."]</MudAlert>
                        }
                        else
                        {
                            <MudTable T="TelemetryResource" Items="_resources" Dense="true" Hover="true" Elevation="0" Outlined="true" Breakpoint="Breakpoint.Md" Class="elsa-otel-table-card">
                                <HeaderContent>
                                    <MudTh>@Localizer["Service"]</MudTh>
                                    <MudTh>@Localizer["Instance"]</MudTh>
                                    <MudTh>@Localizer["SDK"]</MudTh>
                                    <MudTh>@Localizer["Status"]</MudTh>
                                    <MudTh>@Localizer["Last Seen"]</MudTh>
                                </HeaderContent>
                                <RowTemplate>
                                    <MudTd DataLabel="Service"><strong>@context.ServiceName</strong></MudTd>
                                    <MudTd DataLabel="Instance"><span class="elsa-otel-mono">@context.ServiceInstanceId</span></MudTd>
                                    <MudTd DataLabel="SDK">@context.TelemetrySdkLanguage</MudTd>
                                    <MudTd DataLabel="Status"><MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="@ResourceStatusColor(context.Status)">@context.Status</MudChip></MudTd>
                                    <MudTd DataLabel="Last Seen">@FormatTime(context.LastSeen)</MudTd>
                                </RowTemplate>
                            </MudTable>
                        }
                    </MudTabPanel>
                    <MudTabPanel Text="@Localizer["Traces"]">
                        @if (FilteredTraces.Count == 0)
                        {
                            <MudAlert Severity="Severity.Normal" Variant="Variant.Text">@Localizer["No traces received."]</MudAlert>
                        }
                        else
                        {
                            <MudGrid Spacing="3">
                                <MudItem xs="12" lg="@TraceTableColumns">
                                    <MudTable T="TelemetryTrace" Items="FilteredTraces" Dense="true" Hover="true" Elevation="0" Outlined="true" Breakpoint="Breakpoint.Lg" RowClassFunc="TraceRowClass" OnRowClick="SelectTraceFromRowAsync" RowStyle="cursor: pointer;" Class="elsa-otel-table-card">
                                        <ColGroup>
                                            <col style="width: 38%;" />
                                            <col style="width: 9%;" />
                                            <col style="width: 7%;" />
                                            <col style="width: 10%;" />
                                            <col style="width: 26%;" />
                                            <col style="width: 10%;" />
                                        </ColGroup>
                                        <HeaderContent>
                                            <MudTh>@Localizer["Operation"]</MudTh>
                                            <MudTh>@Localizer["Status"]</MudTh>
                                            <MudTh>@Localizer["Spans"]</MudTh>
                                            <MudTh>@Localizer["Duration"]</MudTh>
                                            <MudTh>@Localizer["Trace ID"]</MudTh>
                                            <MudTh>@Localizer["Links"]</MudTh>
                                        </HeaderContent>
                                        <RowTemplate>
                                            <MudTd DataLabel="Operation">
                                                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                                                    @if (TryGetHttpMethod(context.Name) is { } method)
                                                    {
                                                        <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Primary">@method</MudChip>
                                                    }
                                                    <MudText Typo="Typo.body2" Style="overflow: hidden; text-overflow: ellipsis; white-space: nowrap;"><strong>@OperationName(context.Name)</strong></MudText>
                                                </MudStack>
                                            </MudTd>
                                            <MudTd DataLabel="Status"><MudChip T="string" Size="Size.Small" Variant="Variant.Text" Color="@TraceStatusColor(context.Status)">@context.Status</MudChip></MudTd>
                                            <MudTd DataLabel="Spans">@context.SpanCount</MudTd>
                                            <MudTd DataLabel="Duration"><MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="@DurationColor(context.Duration)">@FormatDuration(context.Duration)</MudChip></MudTd>
                                            <MudTd DataLabel="Trace ID">
                                                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1" Style="min-width: 17rem;">
                                                    <MudTooltip Text="@context.TraceId" Delay="500">
                                                        <span class="elsa-otel-mono">@ShortTraceId(context.TraceId, 12, 12)</span>
                                                    </MudTooltip>
                                                    <MudTooltip Text="@Localizer["Copy trace ID"]" Delay="500">
                                                        <MudIconButton Icon="@Icons.Material.Outlined.ContentCopy" Size="Size.Small" OnClick="() => CopyTextAsync(context.TraceId, CopiedTraceIdText)" />
                                                    </MudTooltip>
                                                </MudStack>
                                            </MudTd>
                                            <MudTd DataLabel="Links">
                                                <MudTooltip Text="@Localizer["View structured logs"]" Delay="500">
                                                    <MudIconButton Icon="@Icons.Material.Outlined.Article" Size="Size.Small" Color="Color.Primary" Href="@StructuredLogsHref(context.TraceId, null)" />
                                                </MudTooltip>
                                            </MudTd>
                                        </RowTemplate>
                                    </MudTable>
                                </MudItem>
                                @if (IsTraceDetailsVisible && _selectedTraceDetail?.Trace is { } trace)
                                {
                                    <MudItem xs="12" lg="4">
                                        <MudPaper Elevation="0" Outlined="true" Class="pa-4">
                                            <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-3">
                                                <MudText Typo="Typo.h6">@Localizer["Trace Details"]</MudText>
                                                <MudIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small" OnClick="CloseTraceDrawer" />
                                            </MudStack>
                                            <MudStack Spacing="2">
                                                <MudText Typo="Typo.caption" Class="elsa-otel-kpi-title">@Localizer["Operation"]</MudText>
                                                <MudText Typo="Typo.subtitle1"><strong>@(trace.Name ?? trace.TraceId)</strong></MudText>
                                                <MudDivider />
                                                <MudSimpleTable Dense="true" Hover="false">
                                                    <tbody>
                                                    <tr><th>@Localizer["Trace ID"]</th><td class="elsa-otel-mono">@trace.TraceId</td></tr>
                                                    <tr><th>@Localizer["Status"]</th><td><MudChip T="string" Size="Size.Small" Variant="Variant.Text" Color="@TraceStatusColor(trace.Status)">@trace.Status</MudChip></td></tr>
                                                    <tr><th>@Localizer["Duration"]</th><td><MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="@DurationColor(trace.Duration)">@FormatDuration(trace.Duration)</MudChip></td></tr>
                                                    <tr><th>@Localizer["Spans"]</th><td>@trace.SpanCount</td></tr>
                                                    <tr><th>@Localizer["Resource"]</th><td>@TraceResourceNames(trace)</td></tr>
                                                    </tbody>
                                                </MudSimpleTable>
                                                <MudStack Row="true" Spacing="1" Class="flex-wrap">
                                                    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Outlined.Article" Href="@StructuredLogsHref(trace.TraceId, _selectedSpan?.SpanId)">@Localizer["View structured logs"]</MudButton>
                                                    <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Outlined.ContentCopy" OnClick="() => CopyTextAsync(trace.TraceId, CopiedTraceIdText)">@Localizer["Copy trace ID"]</MudButton>
                                                </MudStack>
                                                @if (!string.IsNullOrWhiteSpace(_copyStatus))
                                                {
                                                    <MudText Typo="Typo.caption" Class="elsa-otel-muted">@_copyStatus</MudText>
                                                }
                                                <MudDivider />
                                                <MudText Typo="Typo.subtitle2">@Localizer["Span timeline"]</MudText>
                                                <TraceWaterfall Spans="_selectedTraceDetail.Spans" SelectedSpan="_selectedSpan" SelectedSpanChanged="SelectSpanAsync" />
                                                <SpanDetailsDrawer Span="_selectedSpan" />
                                            </MudStack>
                                        </MudPaper>
                                    </MudItem>
                                }
                            </MudGrid>
                        }
                    </MudTabPanel>
                    <MudTabPanel Text="@Localizer["Metrics"]">
                        <MetricSeriesTable Metrics="_metrics" />
                    </MudTabPanel>
                    <MudTabPanel Text="@Localizer["Logs"]">
                        @if (_logs.Count == 0)
                        {
                            <MudAlert Severity="Severity.Normal" Variant="Variant.Text">@Localizer["No OTLP logs received."]</MudAlert>
                        }
                        else
                        {
                            <MudTable T="OtlpLogRecord" Items="_logs" Dense="true" Hover="true" Elevation="0" Outlined="true" Breakpoint="Breakpoint.Md" Class="elsa-otel-table-card">
                                <HeaderContent>
                                    <MudTh>@Localizer["Time"]</MudTh>
                                    <MudTh>@Localizer["Severity"]</MudTh>
                                    <MudTh>@Localizer["Message"]</MudTh>
                                    <MudTh>@Localizer["Trace ID"]</MudTh>
                                    <MudTh>@Localizer["Links"]</MudTh>
                                </HeaderContent>
                                <RowTemplate>
                                    <MudTd DataLabel="Time">@FormatTime(context.Timestamp)</MudTd>
                                    <MudTd DataLabel="Severity"><MudChip T="string" Size="Size.Small" Variant="Variant.Text">@context.SeverityText</MudChip></MudTd>
                                    <MudTd DataLabel="Message">@context.Body</MudTd>
                                    <MudTd DataLabel="Trace ID"><span class="elsa-otel-mono">@ShortTraceId(context.TraceId, 8, 8)</span></MudTd>
                                    <MudTd DataLabel="Links">
                                        <MudStack Row="true" Spacing="1">
                                            @if (!string.IsNullOrWhiteSpace(context.TraceId))
                                            {
                                                <MudTooltip Text="@Localizer["Structured Logs"]" Delay="500">
                                                    <MudIconButton Icon="@Icons.Material.Outlined.Article" Size="Size.Small" Color="Color.Primary" Href="@StructuredLogsHref(context.TraceId, context.SpanId)" />
                                                </MudTooltip>
                                            }
                                            <MudTooltip Text="@Localizer["Console Logs"]" Delay="500">
                                                <MudIconButton Icon="@Icons.Material.Outlined.Terminal" Size="Size.Small" Color="Color.Primary" Href="@ConsoleLogsHref(context.ResourceId, context.Timestamp)" />
                                            </MudTooltip>
                                        </MudStack>
                                    </MudTd>
                                </RowTemplate>
                            </MudTable>
                        }
                    </MudTabPanel>
                    <MudTabPanel Text="@Localizer["Collector Setup"]">
                        @if (_collectorConfiguration == null)
                        {
                            <MudAlert Severity="Severity.Normal" Variant="Variant.Text">@Localizer["Collector configuration is unavailable."]</MudAlert>
                        }
                        else
                        {
                            var setup = CollectorConfigurationViewModelMapper.Create(_collectorConfiguration);
                            <MudPaper Elevation="0" Outlined="true" Class="pa-3 mb-3">
                                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mb-3">
                                    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Outlined.ContentCopy" OnClick="() => CopyEnvironmentVariablesAsync(setup.EnvironmentVariables)">@Localizer["Copy all"]</MudButton>
                                    @if (!string.IsNullOrWhiteSpace(_copyStatus))
                                    {
                                        <MudText Typo="Typo.body2">@_copyStatus</MudText>
                                    }
                                </MudStack>
                                <MudSimpleTable Dense="true" Hover="false">
                                    <tbody>
                                    @foreach (var row in setup.Rows)
                                    {
                                        <tr>
                                            <th>@row.Label</th>
                                            <td class="elsa-otel-mono">@row.Value</td>
                                        </tr>
                                    }
                                    </tbody>
                                </MudSimpleTable>
                            </MudPaper>
                            <MudTable T="CollectorEnvironmentVariable" Items="setup.EnvironmentVariables" Dense="true" Hover="true" Elevation="0" Outlined="true" Breakpoint="Breakpoint.Md" Class="elsa-otel-table-card">
                                <HeaderContent>
                                    <MudTh>@Localizer["Variable"]</MudTh>
                                    <MudTh>@Localizer["Value"]</MudTh>
                                    <MudTh>@Localizer["Actions"]</MudTh>
                                </HeaderContent>
                                <RowTemplate>
                                    <MudTd DataLabel="Variable"><span class="elsa-otel-mono">@context.Name</span></MudTd>
                                    <MudTd DataLabel="Value"><span class="elsa-otel-mono">@(context.IsSecret ? "********" : context.Value)</span></MudTd>
                                    <MudTd DataLabel="Actions">
                                        <MudTooltip Text="@Localizer["Copy"]" Delay="500">
                                            <MudIconButton Icon="@Icons.Material.Outlined.ContentCopy" Color="Color.Primary" Size="Size.Small" OnClick="() => CopyEnvironmentVariablesAsync([context])" />
                                        </MudTooltip>
                                    </MudTd>
                                </RowTemplate>
                            </MudTable>
                        }
                    </MudTabPanel>
                </MudTabs>
        </MudPaper>
    }
</MudContainer>
