<MudButton ButtonType="ButtonType.Button"
           Class="elsa-login-method-button"
           Color="Color.Inherit"
           EndIcon="@Icons.Material.Outlined.ArrowForward"
           FullWidth="true"
           Size="Size.Large"
           StartIcon="@Icon"
           Variant="Variant.Text"
           aria-label="@Localizer["Sign in with {0}", Method.DisplayName]"
           OnClick="HandleClickAsync">
    <span class="elsa-login-method-button__label">@Method.DisplayName</span>
</MudButton>

@code {
    [Parameter, EditorRequired]
    public LoginMethodDescriptor Method { get; set; } = default!;

    [Parameter]
    public string Icon { get; set; } = Icons.Material.Outlined.AccountCircle;

    [Parameter]
    public EventCallback OnClick { get; set; }

    private Task HandleClickAsync() => OnClick.InvokeAsync();
}
