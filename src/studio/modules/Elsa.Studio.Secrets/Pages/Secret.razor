@page "/security/secrets/{Name}"
@using System.Globalization
@using Elsa.Studio.Contracts
@using Elsa.Studio.Secrets.Client
@inject IBackendApiClientProvider ApiClientProvider
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject NavigationManager NavigationManager

<PageTitle>Secret</PageTitle>

<style>
    .secret-loading {
        align-items: center;
        display: flex;
        justify-content: center;
        min-height: 16rem;
    }

    .secret-title-group {
        min-width: 0;
    }

    .secret-technical-name {
        color: var(--mud-palette-text-secondary, #5f6b7a);
        font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
        overflow-wrap: anywhere;
    }

    .secret-data-item span {
        color: var(--mud-palette-text-secondary, #5f6b7a);
        font-size: var(--mud-typography-caption-size, .75rem);
    }

    .secret-data-grid {
        display: grid;
        gap: 0 1rem;
        grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .secret-data-item {
        border-bottom: 1px solid var(--mud-palette-lines-default, #d7dde5);
        display: grid;
        gap: .25rem;
        min-width: 0;
        padding: .75rem 0;
    }

    .secret-data-item strong {
        font-weight: 600;
        overflow-wrap: anywhere;
    }

    .secret-danger-panel {
        border-color: color-mix(in srgb, var(--mud-palette-error, #f44336) 30%, var(--mud-palette-lines-default, #d7dde5)) !important;
    }

    .secret-edit-button {
        white-space: nowrap;
    }

    @@media (max-width: 40rem) {
        .secret-data-grid {
            grid-template-columns: 1fr;
        }

        .secret-chip-row {
            justify-content: flex-start !important;
        }
    }
</style>

<MudContainer MaxWidth="MaxWidth.Large">
    <MudStack Spacing="3" Class="py-4">
        <MudButton Variant="Variant.Text"
                   StartIcon="@Icons.Material.Outlined.ArrowBack"
                   Class="align-self-start"
                   Href="security/secrets">
            Secrets
        </MudButton>

        @if (_secret == null)
        {
            @if (!string.IsNullOrWhiteSpace(_loadError))
            {
                <MudAlert Severity="Severity.Error" Variant="Variant.Outlined">@_loadError</MudAlert>
            }
            else
            {
                <div class="secret-loading">
                    <MudProgressCircular Indeterminate="true" Color="Color.Primary" aria-label="Loading secret" />
                </div>
            }
        }
        else
        {
            <MudPaper Outlined="true" Class="pa-4">
                <MudGrid>
                    <MudItem xs="12" md="7">
                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="3">
                            <MudAvatar Color="Color.Primary" Variant="Variant.Outlined" Size="Size.Medium">
                                <MudIcon Icon="@Icons.Material.Outlined.Key" />
                            </MudAvatar>
                            <div class="secret-title-group">
                                <MudText Typo="Typo.h5" HtmlTag="h1" Color="Color.Primary">@_secret.DisplayName</MudText>
                                <MudText Typo="Typo.caption" Class="secret-technical-name">@_secret.Name</MudText>
                            </div>
                        </MudStack>
                    </MudItem>
                    <MudItem xs="12" md="5">
                        <MudStack Row="true"
                                  Wrap="Wrap.Wrap"
                                  Spacing="1"
                                  AlignItems="AlignItems.Center"
                                  Justify="Justify.FlexEnd"
                                  Class="secret-chip-row">
                            <MudChip T="string" Size="Size.Small" Color="@StatusColor(_secret.Status)">@_secret.Status</MudChip>
                            <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">@_secret.TypeName</MudChip>
                            <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">@_secret.StoreName</MudChip>
                            <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">Version @VersionText</MudChip>
                        </MudStack>
                    </MudItem>
                </MudGrid>
            </MudPaper>

            <MudPaper Outlined="true">
                <MudTabs Border="false"
                         Elevation="0"
                         KeepPanelsAlive="true"
                         AlwaysShowScrollButtons="false"
                         MinimumTabWidth="100"
                         TabPanelsClass="pa-4 pa-sm-6">
                    <MudTabPanel Text="Overview" Icon="@Icons.Material.Outlined.Info">
                        <MudGrid Spacing="4">
                            <MudItem xs="12" md="8">
                                <MudStack Spacing="3">
                                    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Spacing="2">
                                        <div>
                                            <MudText Typo="Typo.h6">Secret details</MudText>
                                            <MudText Typo="Typo.caption">Identity and metadata for this stored secret.</MudText>
                                        </div>
                                        @if (!_isEditingDetails)
                                        {
                                            <MudButton Variant="Variant.Outlined"
                                                       Color="Color.Primary"
                                                       Size="Size.Small"
                                                       Class="secret-edit-button"
                                                       StartIcon="@Icons.Material.Outlined.Edit"
                                                       OnClick="StartEditingDetails">
                                                Edit details
                                            </MudButton>
                                        }
                                    </MudStack>

                                    @if (_isEditingDetails)
                                    {
                                        <MudStack Spacing="2">
                                            <MudTextField @bind-Value="_details.DisplayName" Label="Display name" Variant="Variant.Outlined" Margin="Margin.Dense" />
                                            <MudTextField @bind-Value="_details.Description" Label="Description" Variant="Variant.Outlined" Margin="Margin.Dense" Lines="3" />
                                            <MudStack Row="true" Wrap="Wrap.Wrap" Justify="Justify.FlexEnd" Spacing="1">
                                                <MudButton Variant="Variant.Text" OnClick="CancelEditingDetails" Disabled="@_isSavingDetails">Cancel</MudButton>
                                                <MudButton Variant="Variant.Filled"
                                                           Color="Color.Primary"
                                                           StartIcon="@Icons.Material.Filled.Save"
                                                           OnClick="SaveDetailsAsync"
                                                           Disabled="@_isSavingDetails">
                                                    @(_isSavingDetails ? "Saving..." : "Save details")
                                                </MudButton>
                                            </MudStack>
                                        </MudStack>
                                    }
                                    else
                                    {
                                        <MudPaper Outlined="true" Class="pa-4">
                                            <MudText Typo="Typo.caption">Description</MudText>
                                            <MudText Typo="Typo.body2">@ValueOrDash(_secret.Description)</MudText>
                                        </MudPaper>
                                    }

                                    <div class="secret-data-grid">
                                        <div class="secret-data-item">
                                            <span>Technical name</span>
                                            <strong>@_secret.Name</strong>
                                        </div>
                                        <div class="secret-data-item">
                                            <span>Display name</span>
                                            <strong>@_secret.DisplayName</strong>
                                        </div>
                                        <div class="secret-data-item">
                                            <span>Type</span>
                                            <strong>@_secret.TypeName</strong>
                                        </div>
                                        <div class="secret-data-item">
                                            <span>Scope</span>
                                            <strong>@ValueOrDash(_secret.Scope)</strong>
                                        </div>
                                        <div class="secret-data-item">
                                            <span>Created</span>
                                            <strong>@FormatDateTime(_secret.CreatedAt)</strong>
                                        </div>
                                        <div class="secret-data-item">
                                            <span>Updated</span>
                                            <strong>@FormatDateTime(_secret.UpdatedAt)</strong>
                                        </div>
                                    </div>
                                </MudStack>
                            </MudItem>

                            <MudItem xs="12" md="4">
                                <MudStack Spacing="3">
                                    <MudPaper Outlined="true" Class="pa-4">
                                        <MudStack Spacing="2">
                                            <MudText Typo="Typo.h6">At a glance</MudText>
                                            <MudStack Row="true" Wrap="Wrap.Wrap" Spacing="1" Justify="Justify.SpaceBetween">
                                                <MudText Typo="Typo.caption">Status</MudText>
                                                <MudChip T="string" Size="Size.Small" Color="@StatusColor(_secret.Status)">@_secret.Status</MudChip>
                                            </MudStack>
                                            <MudStack Row="true" Wrap="Wrap.Wrap" Spacing="1" Justify="Justify.SpaceBetween">
                                                <MudText Typo="Typo.caption">Current version</MudText>
                                                <MudText Typo="Typo.body2">@VersionText</MudText>
                                            </MudStack>
                                            <MudStack Row="true" Wrap="Wrap.Wrap" Spacing="1" Justify="Justify.SpaceBetween">
                                                <MudText Typo="Typo.caption">Store</MudText>
                                                <MudText Typo="Typo.body2">@_secret.StoreName</MudText>
                                            </MudStack>
                                            <MudStack Row="true" Wrap="Wrap.Wrap" Spacing="1" Justify="Justify.SpaceBetween">
                                                <MudText Typo="Typo.caption">Expires</MudText>
                                                <MudText Typo="Typo.body2">@FormatDateTime(_secret.ExpiresAt)</MudText>
                                            </MudStack>
                                            <MudDivider />
                                            <MudText Typo="Typo.caption">Rotate this secret when its value changes or as part of your credential policy.</MudText>
                                        </MudStack>
                                    </MudPaper>

                                    <MudPaper Outlined="true" Class="pa-4 secret-danger-panel">
                                        <MudStack Spacing="2" AlignItems="AlignItems.Start">
                                            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                                                <MudIcon Icon="@Icons.Material.Outlined.Block" Size="Size.Small" Color="Color.Error" />
                                                <MudText Typo="Typo.h6">Revoke secret</MudText>
                                            </MudStack>
                                            <MudText Typo="Typo.caption">
                                                Revocation changes the secret's lifecycle state and may interrupt workflows that depend on it.
                                            </MudText>
                                            <MudButton Variant="Variant.Outlined"
                                                       Color="Color.Error"
                                                       StartIcon="@Icons.Material.Filled.Block"
                                                       OnClick="RevokeAsync">
                                                Revoke
                                            </MudButton>
                                        </MudStack>
                                    </MudPaper>
                                </MudStack>
                            </MudItem>
                        </MudGrid>
                    </MudTabPanel>

                    <MudTabPanel Text="Rotation" Icon="@Icons.Material.Outlined.Autorenew">
                        <MudGrid Spacing="4">
                            <MudItem xs="12" md="8">
                                <MudStack Spacing="3">
                                    <div>
                                        <MudText Typo="Typo.h6">Rotate secret</MudText>
                                        <MudText Typo="Typo.caption">Replace the stored value and optionally set an expiry for the new version.</MudText>
                                    </div>

                                    <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Dense="true">
                                        A successful rotation creates the next version. Elsa Studio never displays the stored secret value.
                                    </MudAlert>

                                    @if (_secret.StoreName == SecretStoreNames.Configuration)
                                    {
                                        <MudTextField @bind-Value="_rotation.ConfigurationKey"
                                                      Label="Replacement configuration key"
                                                      HelperText="Enter the configuration key that resolves to the replacement value."
                                                      Variant="Variant.Outlined"
                                                      Margin="Margin.Dense" />
                                    }
                                    else
                                    {
                                        <MudTextField @bind-Value="_rotation.Value"
                                                      Label="Replacement value"
                                                      HelperText="The value is sent securely and is not shown again."
                                                      InputType="InputType.Password"
                                                      Variant="Variant.Outlined"
                                                      Margin="Margin.Dense" />
                                    }

                                    <MudText Typo="Typo.subtitle2">Optional expiry</MudText>
                                    <MudGrid Spacing="2">
                                        <MudItem xs="12" sm="7">
                                            <MudDatePicker @bind-Date="_rotationExpiresDate"
                                                           Label="Expiry date"
                                                           Variant="Variant.Outlined"
                                                           Margin="Margin.Dense"
                                                           Clearable="true"
                                                           Editable="true"
                                                           DateFormat="@CultureInfo.CurrentCulture.DateTimeFormat.ShortDatePattern" />
                                        </MudItem>
                                        <MudItem xs="12" sm="5">
                                            <MudTimePicker @bind-Time="_rotationExpiresTime"
                                                           Label="Time"
                                                           Variant="Variant.Outlined"
                                                           Margin="Margin.Dense"
                                                           Clearable="true"
                                                           Editable="true"
                                                           Disabled="@(_rotationExpiresDate == null)"
                                                           TimeFormat="@CultureInfo.CurrentCulture.DateTimeFormat.ShortTimePattern" />
                                        </MudItem>
                                    </MudGrid>

                                    <MudStack Row="true" Wrap="Wrap.Wrap" Justify="Justify.FlexEnd" AlignItems="AlignItems.Center" Spacing="2">
                                        <MudText Typo="Typo.caption">Current version: @VersionText</MudText>
                                        <MudButton Variant="Variant.Filled"
                                                   Color="Color.Primary"
                                                   StartIcon="@Icons.Material.Filled.Autorenew"
                                                   OnClick="RotateAsync">
                                            Rotate secret
                                        </MudButton>
                                    </MudStack>
                                </MudStack>
                            </MudItem>

                            <MudItem xs="12" md="4">
                                <MudPaper Outlined="true" Class="pa-4">
                                    <MudStack Spacing="2">
                                        <MudText Typo="Typo.h6">Rotation context</MudText>
                                        <MudStack Row="true" Wrap="Wrap.Wrap" Spacing="1" Justify="Justify.SpaceBetween">
                                            <MudText Typo="Typo.caption">Current version</MudText>
                                            <MudText Typo="Typo.body2">@VersionText</MudText>
                                        </MudStack>
                                        <MudStack Row="true" Wrap="Wrap.Wrap" Spacing="1" Justify="Justify.SpaceBetween">
                                            <MudText Typo="Typo.caption">Current expiry</MudText>
                                            <MudText Typo="Typo.body2">@FormatDateTime(_secret.ExpiresAt)</MudText>
                                        </MudStack>
                                        <MudStack Row="true" Wrap="Wrap.Wrap" Spacing="1" Justify="Justify.SpaceBetween">
                                            <MudText Typo="Typo.caption">Store</MudText>
                                            <MudText Typo="Typo.body2">@_secret.StoreName</MudText>
                                        </MudStack>
                                        <MudDivider />
                                        <MudText Typo="Typo.caption">
                                            Existing consumers continue to reference this secret by its technical name.
                                        </MudText>
                                    </MudStack>
                                </MudPaper>
                            </MudItem>
                        </MudGrid>
                    </MudTabPanel>
                </MudTabs>
            </MudPaper>
        }
    </MudStack>
</MudContainer>

@code {
    private SecretModel? _secret;
    private readonly RotateSecretRequest _rotation = new();
    private readonly UpdateSecretRequest _details = new();
    private string? _loadedName;
    private string? _loadError;
    private DateTime? _rotationExpiresDate;
    private TimeSpan? _rotationExpiresTime;
    private bool _isEditingDetails;
    private bool _isSavingDetails;

    [Parameter] public string Name { get; set; } = default!;

    protected override async Task OnParametersSetAsync()
    {
        var name = Uri.UnescapeDataString(Name);
        if (string.Equals(_loadedName, name, StringComparison.Ordinal))
            return;

        _loadedName = name;
        _secret = null;
        _loadError = null;
        _isEditingDetails = false;
        _isSavingDetails = false;
        _rotation.Value = null;
        _rotation.ConfigurationKey = null;
        ClearRotationExpiration();
        SyncDetailsModel();

        try
        {
            var api = await ApiClientProvider.GetApiAsync<ISecretsApi>();
            _secret = await api.GetAsync(name);
            SyncDetailsModel();
        }
        catch (Exception e)
        {
            _loadedName = null;
            _loadError = e.Message;
            Snackbar.Add(e.Message, Severity.Error);
        }
    }

    private void StartEditingDetails()
    {
        SyncDetailsModel();
        _isEditingDetails = true;
    }

    private void CancelEditingDetails()
    {
        SyncDetailsModel();
        _isEditingDetails = false;
    }

    private async Task SaveDetailsAsync()
    {
        if (_secret == null)
            return;

        try
        {
            _isSavingDetails = true;
            var api = await ApiClientProvider.GetApiAsync<ISecretsApi>();
            _secret = await api.UpdateAsync(_secret.Name, _details);
            SyncDetailsModel();
            _isEditingDetails = false;
            Snackbar.Add("Secret details updated.", Severity.Success);
        }
        catch (Exception e)
        {
            Snackbar.Add(e.Message, Severity.Error);
        }
        finally
        {
            _isSavingDetails = false;
        }
    }

    private void SyncDetailsModel()
    {
        _details.DisplayName = _secret?.DisplayName;
        _details.Description = _secret?.Description;
    }

    private async Task RotateAsync()
    {
        if (_secret == null)
            return;

        try
        {
            var api = await ApiClientProvider.GetApiAsync<ISecretsApi>();
            _rotation.ExpiresAt = CreateRotationExpiresAt();
            _secret = await api.RotateAsync(_secret.Name, _rotation);
            _rotation.Value = null;
            _rotation.ConfigurationKey = null;
            _rotation.ExpiresAt = null;
            ClearRotationExpiration();
            Snackbar.Add("Secret rotated.", Severity.Success);
        }
        catch (Exception e)
        {
            Snackbar.Add(e.Message, Severity.Error);
        }
    }

    private async Task RevokeAsync()
    {
        if (_secret == null)
            return;

        var confirmed = await DialogService.ShowMessageBoxAsync("Revoke secret?", $"Revoke {_secret.DisplayName}?", yesText: "Revoke", cancelText: "Cancel");
        if (confirmed != true)
            return;

        try
        {
            var api = await ApiClientProvider.GetApiAsync<ISecretsApi>();
            _secret = await api.RevokeAsync(_secret.Name);
            Snackbar.Add("Secret revoked.", Severity.Warning);
            StateHasChanged();
        }
        catch (Exception e)
        {
            Snackbar.Add(e.Message, Severity.Error);
        }
    }

    private string VersionText => _secret?.CurrentVersion?.ToString() ?? "-";

    private DateTimeOffset? CreateRotationExpiresAt()
    {
        if (_rotationExpiresDate == null)
            return null;

        var localDateTime = DateTime.SpecifyKind(_rotationExpiresDate.Value.Date.Add(_rotationExpiresTime ?? TimeSpan.Zero), DateTimeKind.Unspecified);
        return new DateTimeOffset(localDateTime, TimeZoneInfo.Local.GetUtcOffset(localDateTime));
    }

    private void ClearRotationExpiration()
    {
        _rotationExpiresDate = null;
        _rotationExpiresTime = null;
    }

    private static string ValueOrDash(string? value) => string.IsNullOrWhiteSpace(value) ? "-" : value;

    private static string FormatDateTime(DateTimeOffset value) => value == default ? "-" : value.ToLocalTime().ToString("g");

    private static string FormatDateTime(DateTimeOffset? value) => value.HasValue ? FormatDateTime(value.Value) : "-";

    private static Color StatusColor(SecretStatus status) => status switch
    {
        SecretStatus.Active => Color.Success,
        SecretStatus.Revoked or SecretStatus.Deleted => Color.Error,
        SecretStatus.Expired or SecretStatus.Retired => Color.Warning,
        _ => Color.Default
    };
}
