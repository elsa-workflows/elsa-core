    private async Task SaveWorkspaceAsync()
    {
        if (_model is null || !CanSaveConnection || !await ValidateSaveAsync())
            return;

        await SaveAsync(_model);
    }

    private async Task<bool> ValidateSaveAsync()
    {
        if (!IsNew)
            return await ValidateWorkspaceAsync();

        if (_generalEditor is null)
            return false;

        return await _generalEditor.ValidateAsync();
    }

    private async Task<bool> ValidateWorkspaceAsync()
    {
        if (_generalEditor is null || _providerEditor is null)
            return false;

        if (!await _generalEditor.ValidateAsync())
        {
            _activeWorkspaceTab = 0;
            return false;
        }

        if (!await _providerEditor.ValidateAsync())
        {
            _activeWorkspaceTab = 1;
            return false;
        }

        return true;
    }

    private async Task ActivateWorkspaceAsync()
    {
        if (_model is null || !CanActivateConnection || _activating)
            return;

        var creating = IsNew;
        var requiresSave = creating || _isDirty;
        if (requiresSave && (_customEditorType is not null || !await ValidateWorkspaceAsync()))
            return;

        ConnectionDetail? persisted = null;
        _activationCompletionUnknown = false;
        _activating = true;
        try
        {
            var api = await ApiClientProvider.GetApiAsync<IExternalAuthenticationConnectionsApi>();
            if (requiresSave)
            {
                await ReportActivationProgressAsync("Saving configuration…");
                persisted = await PersistConnectionAsync(api, _model, creating);
                if (persisted is null)
                    return;
            }
            else
                persisted = _connection;

            ApplyPersistedConnection(persisted!);
            var result = await ConnectionActivationWorkflow.ExecuteAsync(
                api,
                persisted!,
                requiresSave || !string.Equals(persisted!.Validity, "valid", StringComparison.OrdinalIgnoreCase),
                ReportActivationProgressAsync);
            _validation = result.Validation;
            ApplyPersistedConnection(result.Connection);

            if (result.Status == ConnectionActivationStatus.RevisionChanged)
            {
                _activeWorkspaceTab = DiagnosticsTabIndex;
                Snackbar.Add("The connection changed while it was being checked. Reload and review it before trying again.", Severity.Warning);
                NavigateToPersistedConnectionIfNeeded(creating, result.Connection.Id);
                return;
            }

            if (result.Status == ConnectionActivationStatus.ValidationFailed)
            {
                _activeWorkspaceTab = DiagnosticsTabIndex;
                Snackbar.Add("Connection saved as a draft. Fix the validation issues and try activation again.", Severity.Warning);
                NavigateToPersistedConnectionIfNeeded(creating, result.Connection.Id);
                return;
            }

            if (result.Status == ConnectionActivationStatus.EnableFailed)
            {
                NavigateToPersistedConnectionIfNeeded(creating, result.Connection.Id);
                const string message = "The configuration is valid but is not available for sign-in yet. Retry activation.";
                if (result.Error is ApiException apiException)
                    ShowManagementError(apiException, message);
                else
                    Snackbar.Add(message, Severity.Error);
                return;
            }

            if (result.Status == ConnectionActivationStatus.CompletionUnknown)
            {
                _activationCompletionUnknown = true;
                NavigateToPersistedConnectionIfNeeded(creating, result.Connection.Id);
                Snackbar.Add("Elsa could not confirm whether this connection became available for sign-in. Refresh before retrying activation.", Severity.Error);
                return;
            }

            Snackbar.Add("Connection is available for sign-in.", Severity.Success);
            NavigateToPersistedConnectionIfNeeded(creating, result.Connection.Id);
        }
        catch (ManagementApiException exception) when (exception.IsConcurrencyConflict)
        {
            await RecoverConcurrencyAsync(exception);
        }
        catch (ApiException exception) when (IsConcurrencyConflict(exception))
        {
            await RecoverConcurrencyAsync(new ManagementApiException("The connection changed elsewhere.", (int)exception.StatusCode));
        }
        catch (ApiException exception)
        {
            if (persisted is not null)
                NavigateToPersistedConnectionIfNeeded(creating, persisted.Id);
            ShowManagementError(
                exception,
                _activationProgress.StartsWith("Making", StringComparison.Ordinal)
                    ? "The configuration is valid but is not available for sign-in yet. Retry activation."
                    : null);
        }
        catch (Exception exception)
        {
            if (persisted is not null)
                NavigateToPersistedConnectionIfNeeded(creating, persisted.Id);
            Snackbar.Add(
                _activationProgress.StartsWith("Making", StringComparison.Ordinal)
                    ? "The configuration is valid, but Elsa could not confirm that it is available for sign-in. Refresh before retrying activation."
                    : exception.Message,
                Severity.Error);
        }
        finally
        {
            _activating = false;
            _allowActivationNavigation = false;
            _activationProgress = string.Empty;
        }
    }

    private Task ReportActivationProgressAsync(string message)
    {
        _activationProgress = message;
        return InvokeAsync(StateHasChanged);
    }

    private void ApplyPersistedConnection(ConnectionDetail connection)
    {
        _connection = connection;
        _model = ToMutation(connection);
        _isDirty = false;
    }

    private void NavigateToPersistedConnectionIfNeeded(bool creating, string connectionId)
    {
        if (creating)
        {
            ConnectionId = connectionId;
            _loadedConnectionId = connectionId;
            _allowActivationNavigation = true;
            Navigation.NavigateTo($"security/external-authentication/connections/{Uri.EscapeDataString(connectionId)}", replace: true);
        }
    }

    private async Task<ConnectionDetail?> PersistConnectionAsync(
        IExternalAuthenticationConnectionsApi api,
        ConnectionMutation mutation,
        bool creating)
    {
        mutation.Scope = new ConnectionScope { Kind = "host" };
        if (creating)
            return _canCreate ? await api.CreateAsync(mutation) : null;

        if (_connection is null || string.IsNullOrWhiteSpace(CurrentConnectionId) || !_canUpdate || _connection.IsConfigurationOwned)
            return null;

        return await api.UpdateAsync(CurrentConnectionId, mutation, ConnectionConcurrency.ToIfMatch(_connection.Revision));
    }

    private async Task SaveAsync(ConnectionMutation mutation)
    {
        if (_connection is null)
            return;

        if (!IsNew)
        {
            await UpdateExistingConnectionAsync(mutation, "Connection updated.");
            return;
        }

        try
        {
            var api = await ApiClientProvider.GetApiAsync<IExternalAuthenticationConnectionsApi>();
            var created = await PersistConnectionAsync(api, mutation, creating: true);
            if (created is null)
                return;

            Snackbar.Add("Connection draft created.", Severity.Success);
            _isDirty = false;
            Navigation.NavigateTo($"security/external-authentication/connections/{Uri.EscapeDataString(created.Id)}", replace: true);
        }
        catch (ManagementApiException exception) when (exception.IsConcurrencyConflict)
        {
            await RecoverConcurrencyAsync(exception);
        }
        catch (ApiException exception) when (IsConcurrencyConflict(exception))
        {
            await RecoverConcurrencyAsync(new ManagementApiException("The connection changed elsewhere.", (int)exception.StatusCode));
        }
        catch (ApiException exception)
        {
            ShowManagementError(exception);
        }
        catch (Exception exception)
        {
            Snackbar.Add(exception.Message, Severity.Error);
        }
    }

    private async Task UpdateExistingConnectionAsync(ConnectionMutation mutation, string successMessage)
    {
        if (_connection is null || IsNew || string.IsNullOrWhiteSpace(CurrentConnectionId) || !_canUpdate || _connection.IsConfigurationOwned)
            return;

        try
        {
            var api = await ApiClientProvider.GetApiAsync<IExternalAuthenticationConnectionsApi>();
            var updated = await PersistConnectionAsync(api, mutation, creating: false);
            if (updated is null)
                return;

            ApplyPersistedConnection(updated);
            Snackbar.Add(successMessage, Severity.Success);
        }
        catch (ManagementApiException exception) when (exception.IsConcurrencyConflict)
        {
            await RecoverConcurrencyAsync(exception);
        }
        catch (ApiException exception) when (IsConcurrencyConflict(exception))
        {
            await RecoverConcurrencyAsync(new ManagementApiException("The connection changed elsewhere.", (int)exception.StatusCode));
        }
        catch (ApiException exception)
        {
            ShowManagementError(exception);
        }
        catch (Exception exception)
        {
            Snackbar.Add(exception.Message, Severity.Error);
        }
    }

    private Task SelectAdapterAsync(string adapterType)
    {
        if (_connection is null || _model is null)
            return Task.CompletedTask;

        var adapter = _adapters.FirstOrDefault(item => string.Equals(item.Type, adapterType, StringComparison.Ordinal));
        if (adapter is null)
            return Task.CompletedTask;

        _adapter = adapter;
        ResolveCustomEditor();
        ConnectionAdapterSelection.Apply(_connection, _model, adapter);
        _isDirty = true;
        return Task.CompletedTask;
    }

