    private string? _existingStudioOverrideId;
    private bool _existingStudioOverrideArchived;
    private bool CanCreateFullOverride => _canCreate && _connection?.CanCreateOverride == true && string.IsNullOrWhiteSpace(_existingStudioOverrideId);

    private async Task FindExistingStudioOverrideAsync(IExternalAuthenticationConnectionsApi api)
    {
        if (_connection is null || !_connection.IsConfigurationOwned || !_connection.CanCreateOverride)
            return;

        try
        {
            var response = await api.ListAsync(search: _connection.Key, source: "database", archived: null, pageSize: 25);
            var existing = ConnectionOverrideDiscovery.FindExisting(response.Items, _connection.Key, _connection.Scope);
            _existingStudioOverrideId = existing?.Id;
            _existingStudioOverrideArchived = existing?.Archived == true;
        }
        catch
        {
            // The server already communicates whether a new override is allowed. A failed supplementary lookup
            // must not prevent administrators from viewing the deployment-owned connection.
        }
    }

