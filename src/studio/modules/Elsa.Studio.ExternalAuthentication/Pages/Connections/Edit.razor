    private async Task ToggleEnabledAsync()
    {
        if (_connection is null || string.IsNullOrWhiteSpace(CurrentConnectionId) || !CanToggleEnabled)
            return;

        var action = _connection.EnabledIntent ? "disable" : "enable";
        try
        {
            var api = await ApiClientProvider.GetApiAsync<IExternalAuthenticationConnectionsApi>();
            if (_connection.EnabledIntent)
            {
                var decision = await ConnectionDisableConfirmation.ShowAsync(Dialogs, _connection.DisplayName, _canRevokeSessions);
                if (decision is null)
                    return;
                var revokeActiveSessions = decision == ConnectionDisableDecision.RevokeActiveSessions;

                var operations = await ApiClientProvider.GetApiAsync<IExternalAuthenticationOperationsApi>();
                try
                {
                    await operations.DisableWithRecoveryOverrideAsync(CurrentConnectionId, ConnectionConcurrency.ToIfMatch(_connection.Revision), false, revokeActiveSessions);
                }
                catch (ApiException exception) when (IsFinalLoginPathGuard(exception))
                {
                    if (!_canConfigureUnsafeSettings)
                    {
                        Snackbar.Add("This is the final normal login method. Configure another recovery path before disabling it.", Severity.Error);
                        return;
                    }

                    var confirmed = await Dialogs.ShowMessageBoxAsync(
                        "Confirm recovery override?",
                        "Only confirm this if you have verified an independent recovery path. This privileged override disables the final normal login method; break-glass authentication remains outside normal login discovery.",
                        yesText: "Confirm recovery override",
                        cancelText: "Cancel") == true;
                    if (!confirmed)
                        return;

                    await operations.DisableWithRecoveryOverrideAsync(CurrentConnectionId, ConnectionConcurrency.ToIfMatch(_connection.Revision), true, revokeActiveSessions);
                }
            }
            else
            {
                if (await Dialogs.ShowMessageBoxAsync("Enable connection?", $"This changes the administrative login availability of {_connection.DisplayName}.", yesText: "Enable", cancelText: "Cancel") != true)
                    return;

                await api.EnableAsync(CurrentConnectionId, ConnectionConcurrency.ToIfMatch(_connection.Revision));
            }
            await ReloadConnectionAsync();
            Snackbar.Add($"Connection {action}d.", Severity.Success);
        }
        catch (ManagementApiException exception) when (exception.IsConcurrencyConflict)
        {
            await RecoverConcurrencyAsync(exception);
        }
        catch (ApiException exception) when (IsConcurrencyConflict(exception))
        {
            await RecoverConcurrencyAsync(new ManagementApiException("The connection changed elsewhere.", (int)exception.StatusCode));
        }
        catch (ApiException exception)
        {
            ShowManagementError(exception);
        }
        catch (Exception exception)
        {
            Snackbar.Add(exception.Message, Severity.Error);
        }
    }

