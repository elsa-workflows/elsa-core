    private async Task ValidateAsync()
    {
        if (_connection is null || string.IsNullOrWhiteSpace(CurrentConnectionId))
            return;

        try
        {
            var api = await ApiClientProvider.GetApiAsync<IExternalAuthenticationConnectionsApi>();
            _validation = null;
            _connection.Validity = "unknown";
            _connection.ValidationErrors = [];
            _connection.ValidationWarnings = [];
            var validation = await api.ValidateAsync(CurrentConnectionId);
            _activeWorkspaceTab = DiagnosticsTabIndex;
            var refreshed = await api.GetAsync(CurrentConnectionId);
            if (refreshed.Revision != _connection.Revision)
            {
                Snackbar.Add("The connection changed while it was being validated. Reload it before validating again.", Severity.Warning);
                return;
            }
            _validation = validation;
            _connection.Validity = refreshed.Validity;
            _connection.ValidationErrors = refreshed.ValidationErrors;
            _connection.ValidationWarnings = refreshed.ValidationWarnings;
        }
        catch (ApiException exception)
        {
            ShowManagementError(exception);
        }
        catch (Exception exception)
        {
            Snackbar.Add(exception.Message, Severity.Error);
        }
    }

    private async Task RecoverConcurrencyAsync(ManagementApiException exception)
    {
        var reload = await Dialogs.ShowMessageBoxAsync("Connection changed elsewhere", "Another administrator changed this connection. Reload the current version? Your unsaved changes will be discarded.", yesText: "Reload", cancelText: "Cancel");
        if (reload == true)
        {
            if (ConnectionConflictRecovery.TryGetCurrent(exception, out var current))
            {
                _connection = current;
                _model = ToMutation(_connection);
            }
            else
            {
                await ReloadConnectionAsync();
            }
        }
    }

    private async Task ReloadConnectionAsync()
    {
        if (_connection is null || string.IsNullOrWhiteSpace(CurrentConnectionId))
            return;
        var api = await ApiClientProvider.GetApiAsync<IExternalAuthenticationConnectionsApi>();
        _connection = await api.GetAsync(CurrentConnectionId);
        _model = ToMutation(_connection);
        _isDirty = false;
        _activationCompletionUnknown = false;
    }

    private Task OnObservationRecordedAsync(ConnectionObservation observation)
    {
        if (_connection is not null)
            _connection.LatestObservation = observation;
        return Task.CompletedTask;
    }

    private Task MarkDirty()
    {
        _activationCompletionUnknown = false;
        _isDirty = true;
        return Task.CompletedTask;
    }

    private async Task OnPolicyChangedAsync(PolicySelection? policy)
    {
        if (_model is null)
            return;

        _model.UnlinkedPolicy = policy;
        await MarkDirty();
    }

    private async Task ConfirmNavigationAsync(LocationChangingContext context)
    {
        if (_activating && !_allowActivationNavigation)
        {
            context.PreventNavigation();
            return;
        }

        if (!_isDirty)
            return;

        var leave = await Dialogs.ShowMessageBoxAsync(
            "Discard unsaved changes?",
            "You have unsaved connection changes. Leave this page and discard them?",
            yesText: "Discard changes",
            cancelText: "Stay");
        if (leave != true)
            context.PreventNavigation();
    }

    private static ConnectionMutation ToMutation(ConnectionDetail connection) => new()
    {
        Key = connection.Key,
        Scope = new ConnectionScope { Kind = "host" },
        OverridesConfigurationConnection = connection.OverridesConfigurationConnection,
        AdapterType = connection.AdapterType,
        DisplayName = connection.DisplayName,
        IconId = connection.IconId,
        Order = connection.Order,
        IsPreferred = connection.IsPreferred,
        AdapterSettingsVersion = connection.AdapterSettingsVersion,
        AdapterSettings = new Dictionary<string, JsonElement>(connection.AdapterSettings, StringComparer.Ordinal),
        UnlinkedPolicy = connection.UnlinkedPolicy,
        PermissionGrantSources = connection.PermissionGrantSources
            .Select(source => new PermissionGrantSourceSelection
            {
                Type = source.Type,
                SettingsVersion = source.SettingsVersion,
                Settings = new Dictionary<string, JsonElement>(source.Settings, StringComparer.Ordinal),
                Order = source.Order
            })
            .ToList(),
        ClaimProjection = new ClaimProjection
        {
            AllowedClaimTypes = connection.ClaimProjection.AllowedClaimTypes.ToArray(),
            RedactedClaimTypes = connection.ClaimProjection.RedactedClaimTypes.ToArray(),
            MaximumClaimCount = connection.ClaimProjection.MaximumClaimCount,
            MaximumValueLength = connection.ClaimProjection.MaximumValueLength,
            MaximumTotalBytes = connection.ClaimProjection.MaximumTotalBytes
        },
        UpstreamLogoutMode = connection.UpstreamLogoutMode
    };

    private static bool IsConcurrencyConflict(ApiException exception) => ConnectionConcurrency.IsConflict(exception.StatusCode);
    private static bool IsFinalLoginPathGuard(ApiException exception) =>
        ConnectionManagementError.IsFinalLoginPathGuard(exception.StatusCode, exception.Content);
    private void ShowManagementError(ApiException exception, string? prefix = null)
    {
        var error = ConnectionManagementError.Parse(exception.StatusCode, exception.Content, exception.Message);
        var message = string.IsNullOrWhiteSpace(prefix) ? error.DisplayMessage : $"{prefix} {error.DisplayMessage}";
        Snackbar.Add(message, Severity.Error);
    }

    private void StartFullOverride()
    {
        if (_connection is null || _model is null || !_connection.IsConfigurationOwned || !_connection.CanCreateOverride || !_canCreate)
            return;

        _model.OverridesConfigurationConnection = true;
        _model.Scope = new ConnectionScope { Kind = "host" };
        _connection = new ConnectionDetail
        {
            Source = "database",
            AdapterType = _connection.AdapterType,
            AdapterSettingsVersion = _connection.AdapterSettingsVersion,
            Scope = new ConnectionScope { Kind = "host" }
        };
        ConnectionId = null;
        _isDirty = true;
        Snackbar.Add("A complete Database-owned copy is ready. Review every field and reconfigure its secrets after saving the draft.", Severity.Info);
    }

    private async Task PromoteToConfigurationOverrideAsync()
    {
        if (_connection is null || !CanPromoteCurrentConnection)
            return;

        var confirmed = await Dialogs.ShowMessageBoxAsync(
            "Make this Database record effective?",
            "This makes the existing Database record override deployment configuration. Its configured secret bindings are preserved. While disabled, it still shadows deployment configuration; archiving it reveals the deployment connection again.",
            yesText: "Make record effective",
            cancelText: "Cancel") == true;
        if (!confirmed)
            return;

        var mutation = ToMutation(_connection);
        mutation.OverridesConfigurationConnection = true;
        await UpdateExistingConnectionAsync(mutation, "This Database record now overrides deployment configuration.");
    }

