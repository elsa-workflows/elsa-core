@using Elsa.Studio.Authorization

<AccessNotice TestId="access-denied" Title="You don't have access to this page">
    <Message>Your current sign-in does not include <code>@string.Join(", ", MissingPermissions)</code>.</Message>
</AccessNotice>

@code {
    /// <summary>The permissions the user is missing.</summary>
    [Parameter, EditorRequired] public IReadOnlyCollection<Permission> MissingPermissions { get; set; } = [];
}
