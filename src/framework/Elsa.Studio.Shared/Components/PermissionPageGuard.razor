@using Elsa.Studio.Authorization
@inherits PermissionTrackingComponentBase

@if (TrackedPermissions == null)
{
    @* Resolving permissions: render nothing rather than letting a gated page issue API calls. *@
}
else if (TrackedPermissions.GetMissing(_requiredPermissions) is { Count: > 0 } missingPermissions)
{
    <PageTitle>Access denied</PageTitle>
    <AccessDenied MissingPermissions="missingPermissions" />
}
else
{
    @* The page and its components receive the resolved permissions as a cascading UserPermissions, so they can hide
       actions the user cannot perform without resolving the permissions again (see PermissionView). *@
    <CascadingValue Value="TrackedPermissions">
        @ChildContent
    </CascadingValue>
}

@code {
    private Type? _pageType;
    private IReadOnlyCollection<Permission> _requiredPermissions = [];

    /// <summary>The current route, cascaded by the shell's router.</summary>
    [CascadingParameter] public RouteData? RouteData { get; set; }

    /// <summary>The page content to render when the user holds every permission the page declares.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>
    /// Resolves the permissions once for the lifetime of the layout, rather than per navigation, and again whenever the
    /// authentication state changes.
    /// </summary>
    protected override Task OnInitializedAsync() => TrackPermissionsAsync();

    /// <inheritdoc />
    protected override void OnParametersSet()
    {
        var pageType = RouteData?.PageType;

        if (pageType == _pageType)
            return;

        _pageType = pageType;
        _requiredPermissions = pageType != null ? RequirePermissionAttribute.GetRequiredPermissions(pageType) : [];
    }
}
