@using Elsa.Studio.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.Extensions.DependencyInjection
@implements IDisposable
@inject IPermissionService PermissionService
@inject IServiceProvider Services

@if (_missingPermissions == null)
{
    @* Resolving permissions for a gated page: render nothing rather than letting the page issue API calls. *@
}
else if (_missingPermissions.Count > 0)
{
    <PageTitle>Access denied</PageTitle>
    <AccessDenied MissingPermissions="_missingPermissions" />
}
else
{
    @ChildContent
}

@code {
    private static readonly IReadOnlyCollection<Permission> None = [];
    private Type? _pageType;
    private IReadOnlyCollection<Permission>? _missingPermissions;
    private int _evaluation;

    /// <summary>The current route, cascaded by the shell's router.</summary>
    [CascadingParameter] public RouteData? RouteData { get; set; }

    /// <summary>The page content to render when the user holds every permission the page declares.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    private AuthenticationStateProvider? _authenticationStateProvider;

    /// <inheritdoc />
    protected override void OnInitialized()
    {
        // Claims can change while a page stays mounted (e.g. a refreshed token carrying new grants).
        _authenticationStateProvider = Services.GetService<AuthenticationStateProvider>();
        if (_authenticationStateProvider != null)
            _authenticationStateProvider.AuthenticationStateChanged += OnAuthenticationStateChanged;
    }

    /// <inheritdoc />
    protected override async Task OnParametersSetAsync()
    {
        var pageType = RouteData?.PageType;

        if (pageType == _pageType && _missingPermissions != null)
            return;

        _pageType = pageType;
        _missingPermissions = null;
        await EvaluateAsync(pageType);
    }

    /// <inheritdoc />
    public void Dispose()
    {
        if (_authenticationStateProvider != null)
            _authenticationStateProvider.AuthenticationStateChanged -= OnAuthenticationStateChanged;
    }

    private async Task EvaluateAsync(Type? pageType)
    {
        var evaluation = ++_evaluation;
        var required = pageType != null ? RequirePermissionAttribute.GetRequiredPermissions(pageType) : None;

        if (required.Count == 0)
        {
            _missingPermissions = None;
            return;
        }

        var permissions = await PermissionService.GetPermissionsAsync();

        // Ignore the result if the user navigated, or permissions were re-evaluated, while this one was resolving.
        if (evaluation == _evaluation)
            _missingPermissions = permissions.GetMissing(required);
    }

    // Re-evaluates without clearing the current decision first, so a permitted page is not unmounted while it runs.
    private async void OnAuthenticationStateChanged(Task<AuthenticationState> state) =>
        await InvokeAsync(async () =>
        {
            await EvaluateAsync(_pageType);
            StateHasChanged();
        });
}
