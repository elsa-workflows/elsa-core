{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning",
      "Nuplane": "Warning",
      "CShells": "Warning"
    },
    "Console": {
      "FormatterOptions": {
        "ColorBehavior": "Enabled"
      }
    }
  },
  "Diagnostics": {
    "OpenTelemetry": {
      "Exporter": {
        "Endpoint": "http://localhost:5002/elsa/otlp",
        "Protocol": "http/protobuf"
      }
    }
  },
  "AllowedHosts": "*",
  "CShells": {
    "Shells": {
      "Default": {
        "Configuration": {
          "WebRouting": {
            "Path": ""
          }
        },
        "Features": {
          "ShellsApi": {},
          "DefaultAuthentication": {},
          "Resilience": {},
          "Identity": {
            "SigningKey": "CHANGE_ME_TO_A_SECURE_RANDOM_KEY"
          },
          "FastEndpoints": {
            "GlobalRoutePrefix": "elsa/api"
          },
          "SqliteWorkflowPersistence": {
            "ConnectionString": "Data Source=elsa_workflows.db;Cache=Shared"
          },
          "SqliteIdentityPersistence": {
            "ConnectionString": "Data Source=elsa_workflows.db;Cache=Shared"
          },
          "SqliteExternalAuthenticationPersistence": {
            "ConnectionString": "Data Source=elsa_workflows.db;Cache=Shared"
          },
          "Http": {
            "HttpActivityOptions": {
              "BaseUrl": "https://localhost:5001"
            }
          },
          "StructuredLogs": {},
          "ConsoleLogs": {},
          "OpenTelemetry": {},
          "Alterations": {},
          "Secrets": {
            "EncryptionKey": "Q0hBTkdFX01FX1RPX0FfU0VDVVJFX1JBTkRPTV9LRVk="
          },
          "ExternalAuthentication": {
            "AllowConfigurationConnectionOverrides": true,
            "LocalLogin": {
              "IsEnabled": true
            },
            "Redirects": {
              "ExternalCallbackBaseUri": "https://localhost:7294/elsa/api/"
            },
            "ProviderEgress": {
              "RequireHttps": true,
              "AllowPrivateNetworkDestinations": true,
              "AllowedHosts": [
                "localhost"
              ]
            },
            "UnlinkedIdentityPolicy": {
              "DefaultType": "reject",
              "AllowDatabaseConnectionOverride": true
            },
            "Connections": [],
            "AuthenticationClients": [
              {
                "ClientId": "elsa-studio-server",
                "DisplayName": "Elsa Studio Server",
                "ClientType": "Confidential",
                "CallbackUris": [
                  "https://localhost:7113/authentication/external/callback"
                ],
                "LogoutCallbackUris": [
                  "https://localhost:7113/authentication/external/logout-callback"
                ],
                "AllowedReturnPathPrefixes": [
                  "/"
                ],
                "SecretBinding": {
                  "Ownership": "External",
                  "ResolverType": "configuration",
                  "Reference": "ExternalAuthentication:Secrets:StudioServerClientSecret"
                },
                "IsEnabled": true
              }
            ],
            "Secrets": {
              "StudioServerClientSecret": "t/6A8piT0E1hbxBSqkppC9Ug2Nr3B9E++GBt10fwhu4=",
              "KeycloakGeneralClientSecret": "elsa-keycloak-client-secret-dev",
              "KeycloakWorkforceClientSecret": "elsa-workforce-client-secret-dev",
              "KeycloakPartnersClientSecret": "elsa-partners-client-secret-dev"
            }
          },
          "SecretsJavaScript": {},
          "DashboardApi": {},
          "WorkflowRuntimeDashboard": {},
          "ConsoleLogsDashboard": {},
          "StructuredLogsDashboard": {},
          "CopilotAI": {},
          "AI": {},
          "AIPersistence": {},
          "SqliteAlterationsPersistence": {
            "ConnectionString": "Data Source=elsa_workflows.db;Cache=Shared"
          },
          "SqliteStructuredLogPersistence": {
            "ConnectionString": "Data Source=elsa_logs.db;Cache=Shared"
          },
          "SampleEndpoint": {}
        }
      }
    }
  },
  "Nuplane": {
    "Setup": {
      "AutomaticReconciliation": true,
      "PollInterval": "00:01:00",
      "Feeds": [
        {
          "Name": "local-packages",
          "DirectoryPath": "packages",
          "IncludePatterns": [
            "*"
          ],
          "Directory": {
            "Watch": true,
            "DebounceWindow": "00:00:01"
          }
        }
      ]
    },
    "Loading": {
      "Enabled": true,
      "SharedAssemblies": [
        {
          "Name": "Nuplane.Abstractions",
          "PublicKeyToken": "31bf3856ad364e35",
          "MajorVersion": 1
        }
      ]
    }
  }
}
